foundation:hostedOn rdfs:range foundation:Organization .
foundation:hostedOn rdfs:seeAlso "\nExample:\n  :FoundationRepo foundation:hostedOn :GitHub .\n  :GitLabRepo foundation:hostedOn :GitLab .\n  :BitbucketRepo foundation:hostedOn :Bitbucket .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hostname foundation:isSystemLocked "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:hostname foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hostname rdf:type owl:DatatypeProperty .
foundation:hostname rdfs:comment "Network hostname of the computer"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hostname rdfs:domain foundation:Computer .
foundation:hostname rdfs:label "Nome do Host"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hostname rdfs:range xsd:string .
foundation:hostname rdfs:seeAlso "\nExample:\n  :macbook foundation:hostname \"daniels-macbook\" .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hourlyRate foundation:lastUpdatedAt "2026-04-10T03:25:14.481436+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hourlyRate rdf:type owl:DatatypeProperty .
