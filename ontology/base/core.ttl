foundation:triageBlockRule rdfs:label "Triage Block Rule"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:triageBlockRule rdfs:range xsd:string .
foundation:triageIgnoreSender rdf:type owl:DatatypeProperty .
foundation:triageIgnoreSender rdfs:comment "Se true, a triagem de emails ignora/bloqueia automaticamente TODOS os emails deste remetente. Determinístico — o CodeTask lê e bloqueia sem LLM."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:triageIgnoreSender rdfs:domain foundation:EmailAddress .
foundation:triageIgnoreSender rdfs:label "Triage Ignore Sender"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:triageIgnoreSender rdfs:range xsd:boolean .
