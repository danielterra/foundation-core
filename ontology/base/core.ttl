foundation:JobOccupation foundation:hasIcon foundation:icon-material-symbols-name-work_outline .
foundation:JobOccupation foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:JobOccupation rdf:type owl:Class .
foundation:JobOccupation rdfs:comment "A job role with CBO (Classificação Brasileira de Ocupações) code and description"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:JobOccupation rdfs:label "Ocupação Profissional"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:JobOccupation rdfs:seeAlso "\nRepresents a standardized job occupation according to the Brazilian CBO\n(Classificação Brasileira de Ocupações) classification system.\n\nCBO is maintained by the Brazilian Ministry of Labor and is used for\nofficial employment records, labor statistics, and tax purposes.\n\nCardinality constraints:\n- cboCode: exactly 1 (required - CBO code is mandatory)\n- occupationTitle: exactly 1 (required - must have a title)\n- occupationDescription: 0-1 (one description per occupation)\n\nExample:\n  :softwareEngineerJob a foundation:JobOccupation ;\n      foundation:cboCode \"2124-05\" ;\n      foundation:occupationTitle \"Engenheiro de Software\" ;\n      foundation:occupationDescription \"Desenvolve sistemas e aplicações de software\" .\n\n  :dataScientistJob a foundation:JobOccupation ;\n      foundation:cboCode \"2031-05\" ;\n      foundation:occupationTitle \"Cientista de Dados\" ;\n      foundation:occupationDescription \"Analisa e interpreta dados complexos\" .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:JobOccupation rdfs:subClassOf foundation:AbstractContinuant .
foundation:JsonRenderSpec foundation:hasIcon foundation:icon-material-symbols-name-dynamic_form .
foundation:JsonRenderSpec rdf:type owl:Class .
foundation:JsonRenderSpec rdfs:comment "A JSON Render specification stored in the knowledge graph that defines a dynamic UI rendered by the json_render widget on the blackboard. The AI Agent generates this spec declaratively and the widget renders it natively using the Foundation catalog of components."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:JsonRenderSpec rdfs:label "Json Render Spec"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:JsonRenderSpec rdfs:subClassOf foundation:AbstractContinuant .
