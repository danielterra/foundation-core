foundation:Recommendation rdf:type owl:Class .
foundation:Recommendation rdfs:comment "A recommendation made by someone to someone else about anything — a movie, person, place, product, etc."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Recommendation rdfs:label "Recomendação"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Recommendation rdfs:subClassOf foundation:AbstractContinuant .
foundation:RecurringFinancialObligation foundation:hasIcon foundation:icon-material-symbols-name-autorenew .
foundation:RecurringFinancialObligation foundation:lastUpdatedAt "2026-03-04T00:40:30Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:RecurringFinancialObligation rdf:type owl:Class .
foundation:RecurringFinancialObligation rdfs:comment "Compromisso financeiro recorrente entre duas partes — pode ser despesa (creditor ≠ Daniel) ou renda (creditor = Daniel). Gera Payments mensais automaticamente."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RecurringFinancialObligation rdfs:label "Obrigação Financeira Recorrente"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RecurringFinancialObligation rdfs:subClassOf foundation:FinancialObligation .
foundation:RecurringPurchase foundation:hasIcon foundation:icon-material-symbols-name-autorenew .
foundation:RecurringPurchase foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:RecurringPurchase foundation:lastUpdatedAt "2026-03-04T00:40:30Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:RecurringPurchase rdf:type owl:Class .
foundation:RecurringPurchase rdfs:comment "A purchase that recurs over time with a defined period, renewal date and optional start/end dates."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RecurringPurchase rdfs:label "Compra Recorrente"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RecurringPurchase rdfs:subClassOf foundation:Purchase .
