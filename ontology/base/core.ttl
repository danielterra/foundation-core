foundation:hasCountry foundation:lastUpdatedAt "2026-04-10T03:24:59.459349+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasCountry rdf:type owl:ObjectProperty .
foundation:hasCountry rdfs:comment "Links address to a country entity (preferred over country string)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasCountry rdfs:domain foundation:Address .
foundation:hasCountry rdfs:label "Tem País"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasCountry rdfs:range foundation:Country .
foundation:hasCountry rdfs:seeAlso "\nThis property should be used instead of foundation:country for new implementations.\nIt provides a reference to a structured Country entity.\n\nExample:\n  :myAddress foundation:hasCountry :country_brazil .\n\n  :country_brazil a foundation:Country ;\n      foundation:countryName \"Brazil\" ;\n      foundation:countryCode \"BR\" .\n\nNote: Keep foundation:countryCode as a string identifier for ISO codes.\n\nBenefits over string property:\n- Enables country-level hierarchy navigation\n- Supports country codes, currencies, languages\n- Facilitates international queries and analysis\n- Provides structured country metadata\n\nCombined example with full hierarchy:\n  :myAddress a foundation:Address ;\n      foundation:streetNumber \"2775\" ;\n      foundation:hasStreet :street_sete_setembro ;\n      foundation:hasNeighborhood :neighborhood_reboucas ;\n      foundation:hasCity :city_curitiba ;\n      foundation:hasState :state_parana ;\n      foundation:hasCountry :country_brazil ;\n      foundation:postalCode \"80230-010\" .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasCredential foundation:lastUpdatedAt "2026-03-17T04:47:19Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasCredential rdf:type owl:ObjectProperty .
foundation:hasCredential rdfs:comment "Links a connector to its stored credential."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasCredential rdfs:domain foundation:ExternalServiceConnector .
foundation:hasCredential rdfs:domain foundation:IMAPAccount .
foundation:hasCredential rdfs:label "Tem Credencial"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasDependency foundation:lastUpdatedAt "2026-04-10T03:24:59.616303+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasDependency rdf:type owl:ObjectProperty .
