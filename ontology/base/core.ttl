foundation:Person foundation:hasIcon foundation:icon-material-symbols-name-person .
foundation:Person foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:Person foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Person rdf:type owl:Class .
foundation:Person rdfs:comment "A human being (physical nature with agent capacity)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Person rdfs:label "Pessoa"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Person rdfs:seeAlso "\nExamples:\n- Daniel Terra (developer)\n- A team member\n- A user of the system\n- A project contributor\n\nCardinality constraints:\n- name: exactly 1 (required unique identifier)\n- birthDate: max 1 (optional, single date of birth)\n- birthPlace: max 1 (optional, single birth location)\n- father: max 1 (optional, single biological father)\n- mother: max 1 (optional, single biological mother)\n- spouse: max 1 (optional, single spouse)\n- gender: max 1 (optional, single gender identity)\n- sexualOrientation: max 1 (optional, single orientation)\n- maritalStatus: max 1 (optional, single status)\n- bloodType: max 1 (optional, single blood type)\n- height: max 1 (optional, single height measurement)\n- weight: max 1 (optional, single weight measurement)\n- skinColor: max 1 (optional, single classification)\n- residesAt: max 1 (optional, single primary residence)\n- email: 0+ (optional, may have multiple email addresses)\n- hasAddress: 0+ (optional, may have multiple addresses)\n- nationality: 0+ (optional, may have multiple citizenships)\n- hasDocument: 0+ (optional, may have multiple documents)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Person rdfs:subClassOf foundation:AgentCapacity .
foundation:Person rdfs:subClassOf foundation:ConcreteContinuant .
foundation:Persona foundation:hasIcon foundation:icon-material-symbols-name-person_search .
foundation:Persona foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Persona owl:imports foundation:AbstractThing .
foundation:Persona rdf:type owl:Class .
foundation:Persona rdfs:comment "An archetypal user representing a group of real users who share goals, behaviors, and needs"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Persona rdfs:label "Persona"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Persona rdfs:seeAlso "\nPersonas are used in UX design and product planning to ground decisions\nin real user needs rather than assumptions.\n\nExamples:\n- The First-Time User: low technical confidence, needs clear guidance\n- The Power User: values keyboard shortcuts and batch operations\n- The Administrator: manages other users, needs audit trails\n- The Mobile Commuter: uses the app on a phone with intermittent connectivity\n- The Data Analyst: exports data frequently, values precision and completeness\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Persona rdfs:subClassOf foundation:AbstractContinuant .
foundation:PersonalLesson foundation:hasIcon foundation:icon-material-symbols-name-school .
foundation:PersonalLesson foundation:lastUpdatedAt "2026-03-23T21:53:25Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:PersonalLesson rdf:type owl:Class .
foundation:PersonalLesson rdfs:comment "Aprendizado pessoal extraído de uma experiência real — profissional, relacional ou comportamental. Serve como memória de crescimento."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:PersonalLesson rdfs:label "Lição Pessoal"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:PersonalLesson rdfs:subClassOf foundation:AbstractContinuant .
foundation:PhoneNumber foundation:hasIcon foundation:icon-material-symbols-name-phone .
foundation:PhoneNumber foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:PhoneNumber rdf:type owl:Class .
foundation:PhoneNumber rdfs:comment "A telephone number for voice calls, SMS, or other telecommunications services"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:PhoneNumber rdfs:label "Telefone"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:PhoneNumber rdfs:seeAlso "\nRepresents a phone number that can be associated with people, companies, or devices.\n\nPhone numbers can be:\n- Mobile/Cell phone numbers\n- Landline numbers\n- Business phone numbers\n- Virtual numbers\n\nCardinality constraints:\n- localPhoneNumber: exactly 1 (required - the actual phone number)\n- phoneType: 0-1 (optional classification)\n- countryCode: 0-1 (optional country code)\n- areaCode: 0-1 (optional area code)\n- extension: 0-1 (optional extension)\n\nExample:\n  :companyMainPhone a foundation:PhoneNumber ;\n      foundation:localPhoneNumber \"3333-4444\" ;\n      foundation:phoneType \"Business Landline\" ;\n      foundation:countryCode \"+55\" ;\n      foundation:areaCode \"41\" .\n\n  :personalMobile a foundation:PhoneNumber ;\n      foundation:localPhoneNumber \"99999-8888\" ;\n      foundation:phoneType \"Mobile\" ;\n      foundation:countryCode \"+55\" ;\n      foundation:areaCode \"11\" .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:PhoneNumber rdfs:subClassOf foundation:AbstractContinuant .
foundation:PhysicalProduct foundation:allowedStatus foundation:Completed .
foundation:PhysicalProduct foundation:allowedStatus foundation:InProgress .
foundation:PhysicalProduct foundation:allowedStatus foundation:Pending .
