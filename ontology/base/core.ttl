unit:SCM qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/AmountOfSubstance> .
unit:SCM qudt:informativeReference "https://en.wikipedia.org/wiki/Standard_cubic_foot"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
unit:SCM qudt:symbol "scm"^^<http://www.w3.org/2001/XMLSchema#string> .
unit:SCM rdf:type qudt:Unit .
