qudt:IntegerEncodingType <http://purl.org/dc/terms/description> "The encoding scheme for integer types"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:IntegerEncodingType rdf:type owl:Class .
qudt:IntegerEncodingType rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:IntegerEncodingType rdfs:label "Integer Encoding"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:IntegerEncodingType rdfs:subClassOf qudt:Encoding .
qudt:IntervalScale foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:IntervalScale qudt:informativeReference "https://en.wikipedia.org/wiki/Level_of_measurement"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:IntervalScale rdf:type owl:Class .
qudt:IntervalScale rdfs:comment "<p>The interval type allows for the degree of difference between items, but not the ratio between them. Examples include temperature with the Celsius scale, which has two defined points (the freezing and boiling point of water at specific conditions) and then separated into 100 intervals, date when measured from an arbitrary epoch (such as AD), percentage such as a percentage return on a stock,[16] location in Cartesian coordinates, and direction measured in degrees from true or magnetic north. Ratios are not meaningful since 20 °C cannot be said to be \"twice as hot\" as 10 °C, nor can multiplication/division be carried out between any two dates directly. However, ratios of differences can be expressed; for example, one difference can be twice another. Interval type variables are sometimes also called \"scaled variables\", but the formal mathematical term is an affine space (in this case an affine line).</p>\n<p>Characteristics: median, percentile &amp; Monotonic increasing (order (&lt;) &amp; totally ordered set</p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:IntervalScale rdfs:comment "median, percentile & Monotonic increasing (order (<)) & totally ordered set"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:IntervalScale rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:IntervalScale rdfs:label "Interval scale"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:IntervalScale rdfs:seeAlso qudt:NominalScale .
qudt:IntervalScale rdfs:seeAlso qudt:OrdinalScale .
qudt:IntervalScale rdfs:seeAlso qudt:RatioScale .
qudt:IntervalScale rdfs:subClassOf qudt:Scale .
qudt:LatexString foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:LatexString rdf:type rdfs:Datatype .
qudt:LatexString rdfs:comment "A type of string in which some characters may be wrapped with '$' and '$ characters for LaTeX rendering."^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:LatexString rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:LatexString rdfs:label "Latex String"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:LatexString rdfs:subClassOf xsd:string .
qudt:LittleEndian foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:LittleEndian <http://www.linkedmodel.org/schema/dtype#literal> "little"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:LittleEndian rdf:type qudt:EndianType .
qudt:LittleEndian rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:LittleEndian rdfs:label "Little Endian"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:LogarithmicUnit foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:LogarithmicUnit rdf:type owl:Class .
qudt:LogarithmicUnit rdfs:comment "Logarithmic units are abstract mathematical units that can be used to express any quantities (physical or mathematical) that are defined on a logarithmic scale, that is, as being proportional to the value of a logarithm function. Examples of logarithmic units include common units of information and entropy, such as the bit, and the byte, as well as units of relative signal strength magnitude such as the decibel."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:LogarithmicUnit rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:LogarithmicUnit rdfs:label "Logarithmic Unit"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:LogarithmicUnit rdfs:subClassOf qudt:DimensionlessUnit .
qudt:LongUnsignedIntegerEncoding foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:LongUnsignedIntegerEncoding qudt:bytes "8"^^<http://www.w3.org/2001/XMLSchema#integer> .
qudt:LongUnsignedIntegerEncoding rdf:type qudt:IntegerEncodingType .
qudt:LongUnsignedIntegerEncoding rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:LongUnsignedIntegerEncoding rdfs:label "Long Unsigned Integer Encoding"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:MathsFunctionType foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:MathsFunctionType rdf:type owl:Class .
qudt:MathsFunctionType rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:MathsFunctionType rdfs:label "Maths Function Type"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:MathsFunctionType rdfs:subClassOf qudt:Concept .
qudt:NIST_SP811_Comment foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:NIST_SP811_Comment <http://purl.org/dc/elements/1.1/description> "National Institute of Standards and Technology (NIST) Special Publication 811 Comments on some quantities and their units"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:NIST_SP811_Comment rdf:type owl:Class .
qudt:NIST_SP811_Comment rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:NIST_SP811_Comment rdfs:label "NIST SP~811 Comment"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:NIST_SP811_Comment rdfs:subClassOf qudt:Comment .
qudt:NominalScale foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:NominalScale qudt:informativeReference "https://en.wikipedia.org/wiki/Level_of_measurement"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:NominalScale rdf:type owl:Class .
qudt:NominalScale rdfs:comment "A nominal scale differentiates between items or subjects based only on their names or (meta-)categories and other qualitative classifications they belong to; thus dichotomous data involves the construction of classifications as well as the classification of items. Discovery of an exception to a classification can be viewed as progress. Numbers may be used to represent the variables but the numbers do not have numerical value or relationship: For example, a Globally unique identifier. Examples of these classifications include gender, nationality, ethnicity, language, genre, style, biological species, and form. In a university one could also use hall of affiliation as an example."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:NominalScale rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:NominalScale rdfs:label "Nominal scale"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:NominalScale rdfs:seeAlso qudt:IntervalScale .
qudt:NominalScale rdfs:seeAlso qudt:OrdinalScale .
qudt:NominalScale rdfs:seeAlso qudt:RatioScale .
qudt:NominalScale rdfs:subClassOf qudt:Scale .
qudt:NumericUnion foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:NumericUnion rdf:type owl:Class .
qudt:NumericUnion rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:NumericUnion rdfs:label "Numeric union"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:NumericUnion rdfs:subClassOf <http://www.linkedmodel.org/schema/dtype#numericUnion> .
qudt:NumericUnion rdfs:subClassOf qudt:Concept .
qudt:OctetEncoding foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:OctetEncoding qudt:bytes "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
qudt:OctetEncoding rdf:type qudt:BooleanEncodingType .
qudt:OctetEncoding rdf:type qudt:ByteEncodingType .
qudt:OctetEncoding rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:OctetEncoding rdfs:label "OCTET Encoding"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:OrderedType foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:OrderedType <http://purl.org/dc/terms/description> "Describes how a data or information structure is ordered."^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:OrderedType rdf:type owl:Class .
qudt:OrderedType rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:OrderedType rdfs:label "Ordered type"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:OrderedType rdfs:subClassOf qudt:EnumeratedValue .
qudt:OrdinalScale foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:OrdinalScale qudt:informativeReference "https://en.wikipedia.org/wiki/Level_of_measurement"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:OrdinalScale rdf:type owl:Class .
qudt:OrdinalScale rdfs:comment "The ordinal type allows for rank order (1st, 2nd, 3rd, etc.) by which data can be sorted, but still does not allow for relative degree of difference between them. Examples include, on one hand, dichotomous data with dichotomous (or dichotomized) values such as 'sick' vs. 'healthy' when measuring health, 'guilty' vs. 'innocent' when making judgments in courts, 'wrong/false' vs. 'right/true' when measuring truth value, and, on the other hand, non-dichotomous data consisting of a spectrum of values, such as 'completely agree', 'mostly agree', 'mostly disagree', 'completely disagree' when measuring opinion."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:OrdinalScale rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:OrdinalScale rdfs:label "Ordinal scale"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:OrdinalScale rdfs:seeAlso qudt:IntervalScale .
qudt:OrdinalScale rdfs:seeAlso qudt:NominalScale .
qudt:OrdinalScale rdfs:seeAlso qudt:RatioScale .
qudt:OrdinalScale rdfs:subClassOf qudt:Scale .
qudt:Organization foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:Organization rdf:type owl:Class .
qudt:Organization rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:Organization rdfs:label "Organization"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:Organization rdfs:subClassOf qudt:Concept .
qudt:PartiallyOrdered foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:PartiallyOrdered <http://www.linkedmodel.org/schema/dtype#literal> "partial"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:PartiallyOrdered qudt:plainTextDescription "Partial ordered structure."^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:PartiallyOrdered rdf:type qudt:OrderedType .
qudt:PartiallyOrdered rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:PartiallyOrdered rdfs:label "Partially Ordered"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:PhysicalConstant foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:PhysicalConstant qudt:dbpediaMatch "http://dbpedia.org/resource/Physical_constant"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:PhysicalConstant rdf:type owl:Class .
qudt:PhysicalConstant rdfs:comment "A physical constant is a physical quantity that is generally believed to be both universal in nature and constant in time. It can be contrasted with a mathematical constant, which is a fixed numerical value but does not directly involve any physical measurement. There are many physical constants in science, some of the most widely recognized being the speed of light in vacuum c, Newton's gravitational constant G, Planck's constant h, the electric permittivity of free space ε0, and the elementary charge e. Physical constants can take many dimensional forms, or may be dimensionless depending on the system of quantities and units used."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:PhysicalConstant rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:PhysicalConstant rdfs:label "Physical Constant"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:PhysicalConstant rdfs:subClassOf qudt:Quantity .
qudt:PlaneAngleUnit foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:PlaneAngleUnit rdf:type owl:Class .
qudt:PlaneAngleUnit rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:PlaneAngleUnit rdfs:label "Plane Angle Unit"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:PlaneAngleUnit rdfs:subClassOf qudt:AngleUnit .
qudt:Prefix foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:Prefix rdf:type owl:Class .
qudt:Prefix rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:Prefix rdfs:label "Prefix"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:Prefix rdfs:subClassOf qudt:Concept .
qudt:Prefix rdfs:subClassOf qudt:Verifiable .
qudt:Quantifiable foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:Quantifiable rdf:type owl:Class .
qudt:Quantifiable rdfs:comment "<p><em>Quantifiable</em> ascribes to some thing the capability of being measured, observed, or counted.</p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:Quantifiable rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:Quantifiable rdfs:label "Quantifiable"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:Quantifiable rdfs:subClassOf qudt:Aspect .
qudt:Quantity foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:Quantity qudt:dbpediaMatch "http://dbpedia.org/resource/Quantity"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:Quantity rdf:type owl:Class .
qudt:Quantity rdfs:comment "<p class=\"lm-para\">A <b>quantity</b> is the measurement of an observable property of a particular object, event, or physical system. \n  A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the \n  underlying <b>quantity kind</b> is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific \n  quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as \n  the speed of light in a vacuum, Planck's constant, the electric permittivity of free space, and the fine structure constant. </p>\n<p class=\"lm-para\">In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points, \nvelocity of a car, the pressure of the atmosphere, and a person's weight; and units are used to describe their numerical measure.</p> \n<p class=\"lm-para\">Many <b>quantity kinds</b> are related to each other by various physical laws, and as a result, the associated units of some quantity \nkinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance \ndivided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these \nexpressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded \nas \"fundamental\" in this sense.</p>\n<p class=\"lm-para\">A quantity is distinguished from a \"quantity kind\" in that the former carries a value and the latter is a type specifier.</p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:Quantity rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:Quantity rdfs:label "Quantity"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:Quantity rdfs:subClassOf qudt:Concept .
qudt:Quantity rdfs:subClassOf qudt:Quantifiable .
qudt:QuantityKind foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:QuantityKind qudt:informativeReference "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=112-01-04"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:QuantityKind rdf:type owl:Class .
qudt:QuantityKind rdfs:comment "A <b>Quantity Kind</b> is any observable property that can be  measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:QuantityKind rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:QuantityKind rdfs:label "Quantity Kind"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:QuantityKind rdfs:subClassOf qudt:AbstractQuantityKind .
qudt:QuantityKind rdfs:subClassOf qudt:Verifiable .
qudt:QuantityKindDimensionVector foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:QuantityKindDimensionVector qudt:informativeReference "http://en.wikipedia.org/wiki/Dimensional_analysis"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:QuantityKindDimensionVector qudt:informativeReference "http://web.mit.edu/2.25/www/pdf/DA_unified.pdf"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:QuantityKindDimensionVector rdf:type owl:Class .
qudt:QuantityKindDimensionVector rdfs:comment "<p class=\"lm-para\">A  <em>Quantity Kind Dimension Vector</em> describes the dimensionality of a quantity kind in the context of a system of units. In the SI system of units, the dimensions of a quantity kind are expressed as a product of the basic physical dimensions mass ($M$), length ($L$), time ($T$) current ($I$), amount of substance ($N$), luminous intensity ($J$) and absolute temperature ($\\theta$) as $dim \\, Q = L^{\\alpha} \\, M^{\\beta} \\, T^{\\gamma} \\, I ^{\\delta} \\, \\theta ^{\\epsilon} \\, N^{\\eta} \\, J ^{\\nu}$.</p>\n\n<p class=\"lm-para\">The rational powers of the dimensional exponents, $\\alpha, \\, \\beta, \\, \\gamma, \\, \\delta, \\, \\epsilon, \\, \\eta, \\, \\nu$, are positive, negative, or zero.</p>\n\n<p class=\"lm-para\">For example, the dimension of the physical quantity kind $\\it{speed}$ is $\\boxed{length/time}$, $L/T$ or $LT^{-1}$, and the dimension of the physical quantity kind force is $\\boxed{mass \\times acceleration}$ or $\\boxed{mass \\times (length/time)/time}$, $ML/T^2$ or $MLT^{-2}$ respectively.</p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:QuantityKindDimensionVector rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:QuantityKindDimensionVector rdfs:label "Quantity Kind Dimension Vector"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:QuantityKindDimensionVector rdfs:subClassOf qudt:Concept .
qudt:QuantityKindDimensionVector_CGS foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:QuantityKindDimensionVector_CGS rdf:type owl:Class .
qudt:QuantityKindDimensionVector_CGS rdfs:comment "A <em>CGS Dimension Vector</em> is used to specify the dimensions for a C.G.S. quantity kind."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:QuantityKindDimensionVector_CGS rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:QuantityKindDimensionVector_CGS rdfs:label "CGS Dimension vector"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:QuantityKindDimensionVector_CGS rdfs:subClassOf qudt:QuantityKindDimensionVector .
qudt:QuantityKindDimensionVector_CGS-EMU foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:QuantityKindDimensionVector_CGS-EMU rdf:type owl:Class .
qudt:QuantityKindDimensionVector_CGS-EMU rdfs:comment "A <em>CGS EMU Dimension Vector</em> is used to specify the dimensions for EMU C.G.S. quantity kind."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:QuantityKindDimensionVector_CGS-EMU rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:QuantityKindDimensionVector_CGS-EMU rdfs:label "CGS EMU Dimension vector"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:QuantityKindDimensionVector_CGS-EMU rdfs:subClassOf qudt:QuantityKindDimensionVector_CGS .
qudt:QuantityKindDimensionVector_CGS-ESU foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:QuantityKindDimensionVector_CGS-ESU rdf:type owl:Class .
qudt:QuantityKindDimensionVector_CGS-ESU rdfs:comment "A <em>CGS ESU Dimension Vector</em> is used to specify the dimensions for ESU C.G.S. quantity kind."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:QuantityKindDimensionVector_CGS-ESU rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
