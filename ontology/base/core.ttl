foundation:AIConversation foundation:lastUpdatedAt "2026-06-03T05:25:22.851632300+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:AIConversation foundation:retentionDays "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
foundation:AIConversation rdf:type owl:Class .
foundation:AIConversation rdfs:comment "A conversation between a user and an AI assistant, consisting of AIConversationMessage instances"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIConversation rdfs:label "Conversa com IA"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIConversation rdfs:subClassOf foundation:Conversation .
foundation:AIConversationMessage foundation:hasIcon foundation:icon-material-symbols-name-smart_toy .
foundation:AIConversationMessage foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:AIConversationMessage foundation:lastUpdatedAt "2026-03-04T04:10:27Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:AIConversationMessage owl:imports foundation:Message .
foundation:AIConversationMessage rdf:type owl:Class .
foundation:AIConversationMessage rdfs:comment "A message in a conversation with an AI assistant (LLM). Used for both user messages and assistant responses. Supports structured content blocks including text, images, tool calls, and tool results."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIConversationMessage rdfs:comment "Defines AIConversationMessage class for LLM conversations"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIConversationMessage rdfs:label "Mensagem de IA"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIConversationMessage rdfs:seeAlso "\nExamples:\n- User asks: \"What's the weather in SF?\"\n- Assistant responds with tool use\n- User provides tool results\n- Assistant gives final answer\n\nThis class is LLM-agnostic and works with:\n- Claude (Anthropic)\n- GPT (OpenAI)\n- Gemini (Google)\n- Any other LLM that uses similar message/content block patterns\n\nKey differences from base Message class:\n- content: JSON array of content blocks (not plain text)\n- role: \"user\" or \"assistant\" (required)\n- Supports tool use pattern (tool_use + tool_result blocks)\n- Token tracking for usage/billing\n\nCardinality constraints:\n- role: exactly 1 (required - \"user\" or \"assistant\")\n- content: 1 (required - JSON array of content blocks)\n- tokenCount: 0-1 (optional but recommended for performance)\n- model: 0-1 (optional, only for assistant messages)\n- stopReason: 0-1 (optional, only for assistant messages)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIConversationMessage rdfs:subClassOf foundation:Message .
foundation:AIModel foundation:allowedStatus foundation:Completed .
foundation:AIModel foundation:allowedStatus foundation:Pending .
