unit:PERMITTIVITY_REL qudt:conversionMultiplierSN "0.000000000008854187817"^^<http://www.w3.org/2001/XMLSchema#decimal> .
unit:PERMITTIVITY_REL qudt:dbpediaMatch "http://dbpedia.org/resource/Relative_static_permittivity"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
