foundation:accountCurrency rdfs:domain foundation:BankAccount .
foundation:accountCurrency rdfs:label "moeda da conta"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:accountCurrency rdfs:range qudt:CurrencyUnit .
foundation:accountCurrency rdfs:seeAlso "\nExample:\n  :myAccount foundation:accountCurrency currency:USD .\n  :myBrazilAccount foundation:accountCurrency currency:BRL .\n  :myEuroAccount foundation:accountCurrency currency:EUR .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
