foundation:APIKey foundation:hasIcon foundation:icon-material-symbols-name-vpn_key .
foundation:APIKey foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:APIKey foundation:lastUpdatedAt "2026-03-04T04:10:27Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:APIKey rdf:type owl:Class .
foundation:APIKey rdfs:comment "A unique identifier used to authenticate requests to an API service"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:APIKey rdfs:label "Chave de API"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:APIKey rdfs:seeAlso "\nExamples:\n- Claude AI API key (sk-ant-...)\n- OpenAI API key\n- Google Maps API key\n- GitHub Personal Access Token\n- Stripe API key\n\nAPI keys are typically:\n- Long alphanumeric strings\n- Used in HTTP headers or query parameters\n- Service-specific (non-transferable between services)\n- Can be revoked by the service provider\n- Should be kept secret and not committed to version control\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:APIKey rdfs:subClassOf foundation:Credential .
