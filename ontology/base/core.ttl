foundation:hasScreenCaptureDuration qudt:hasUnit unit:Second .
foundation:hasScreenCaptureDuration rdf:type owl:DatatypeProperty .
foundation:hasScreenCaptureDuration rdfs:comment "Total duration of screen recording in seconds"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasScreenCaptureDuration rdfs:label "has screen capture duration"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasScreenCaptureDuration rdfs:range xsd:integer .
foundation:hasScreenCaptureInterval qudt:hasUnit unit:Second .
foundation:hasScreenCaptureInterval rdf:type owl:DatatypeProperty .
