foundation:KeyResult foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:KeyResult rdf:type owl:Class .
foundation:KeyResult rdfs:comment "A measurable outcome or result that defines success for an Objective. Singular form, not KeyResults."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:KeyResult rdfs:label "Resultado-Chave"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:KeyResult rdfs:seeAlso "\nExamples:\n- Complete 100% of base ontology classes by Dec 31\n- Achieve 1000 triples in knowledge base\n- Reach 50 GitHub stars\n- Process 1M queries without performance issues\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:KeyResult rdfs:subClassOf foundation:Goal .
foundation:LabExam foundation:hasIcon foundation:icon-material-symbols-name-biotech .
foundation:LabExam rdf:type owl:Class .
foundation:LabExam rdfs:comment "Um exame laboratorial específico (ex.: Hemograma Completo, Glicose, TSH). Representa o serviço oferecido por um laboratório com código, tipo de amostra, preparo necessário, jejum, prazo de entrega e preço. Cada instância é o item de um catálogo/orçamento de um laboratório específico."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:LabExam rdfs:label "Exame Laboratorial"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:LabExam rdfs:subClassOf foundation:Service .
