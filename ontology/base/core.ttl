foundation:ToolResult foundation:hasIcon foundation:icon-material-symbols-name-check_circle .
foundation:ToolResult foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ToolResult rdf:type owl:Class .
foundation:ToolResult rdfs:comment "Represents the result of executing a tool/function call"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ToolResult rdfs:label "Tool Result"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ToolResult rdfs:seeAlso "\nExamples:\n- Result from search_classes returning list of classes\n- Result from get_instance returning instance details\n- Error result from failed tool execution\n\nCardinality constraints:\n- resultOf: exactly 1 (required, which ToolUse this is the result of)\n- resultContent: exactly 1 (required, JSON result content)\n- partOfMessage: exactly 1 (required, which message contains this result)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ToolResult rdfs:subClassOf foundation:AbstractContinuant .
foundation:ToolUse foundation:hasIcon foundation:icon-material-symbols-name-construction .
foundation:ToolUse foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ToolUse rdf:type owl:Class .
foundation:ToolUse rdfs:comment "Represents a tool/function call made by an AI assistant during a conversation"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ToolUse rdfs:label "Tool Use"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ToolUse rdfs:seeAlso "\nExamples:\n- AI calls search_classes with query parameter\n- AI calls get_instance with IRI parameter\n- AI calls create_class with label and icon\n\nCardinality constraints:\n- toolName: exactly 1 (required, name of the tool/function)\n- toolUseId: exactly 1 (required, unique ID from API response)\n- toolInput: exactly 1 (required, JSON input parameters)\n- partOfMessage: exactly 1 (required, which message contains this tool use)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ToolUse rdfs:subClassOf foundation:AbstractOccurrent .
