foundation:hasPhoneNumber rdf:type owl:ObjectProperty .
foundation:hasPhoneNumber rdfs:comment "Links a person, company, or device to a phone number (can have multiple)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasPhoneNumber rdfs:domain foundation:AgentCapacity .
foundation:hasPhoneNumber rdfs:label "Tem Número de Telefone"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasPhoneNumber rdfs:range foundation:PhoneNumber .
foundation:hasPhoneNumber rdfs:seeAlso "\nAn entity can have multiple phone numbers (personal, work, mobile, landline, etc.).\n\nCan be used with:\n- foundation:Person (personal or work phone)\n- foundation:Company or foundation:Organization (business phone)\n- foundation:Smartphone (SIM card phone numbers)\n\nExamples:\n  :john foundation:hasPhoneNumber :johnMobile ;\n        foundation:hasPhoneNumber :johnHome ;\n        foundation:hasPhoneNumber :johnWork .\n\n  :acmeCompany foundation:hasPhoneNumber :acmeMainPhone ;\n               foundation:hasPhoneNumber :acmeSupport .\n\n  :iphone foundation:hasPhoneNumber :iphoneSIM1 ;\n          foundation:hasPhoneNumber :iphoneSIM2 .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasPossibleActions foundation:lastUpdatedAt "2026-04-10T03:25:04.516625+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasPossibleActions rdf:type owl:ObjectProperty .
