foundation:Payment rdfs:comment "Pagamentos de bens, serviços ou obrigações"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Payment rdfs:label "Pagamento"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Payment rdfs:seeAlso "\nRepresents a payment transaction.\n\nTypes:\n- Invoice payment\n- Contract payment\n- Purchase payment\n- Subscription payment\n\nExample:\n  :payment1 a foundation:Payment ;\n      foundation:paidBy :johnDoe ;\n      foundation:paidTo :consultingFirm ;\n      foundation:transactionAmount \"2500.00\"^^xsd:decimal ;\n      foundation:transactionCurrency currency:USD ;\n      foundation:transactionDate \"2024-01-20\"^^xsd:date ;\n      foundation:paymentMethod \"Bank Transfer\" ;\n      foundation:forInvoice :invoice123 .\n\nCardinality constraints:\n- paidBy: exactly 1 (required)\n- paidTo: exactly 1 (required)\n- paymentMethod: max 1 (optional)\n- forInvoice: max 1 (optional)\n- forContract: max 1 (optional)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Payment rdfs:subClassOf foundation:FinancialTransaction .
foundation:Payment rdfs:subClassOf _:restriction_5c4f119543766be8 .
