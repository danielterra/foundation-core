foundation:CSVFile rdf:type owl:Class .
foundation:CSVFile rdfs:comment "A CSV (Comma-Separated Values) file. Extends File with CSV-specific metadata extracted automatically on upload: column headers, delimiter, and row count."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CSVFile rdfs:label "Arquivo CSV"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CSVFile rdfs:subClassOf foundation:File .
foundation:CTPS foundation:hasIcon foundation:icon-material-symbols-name-work .
foundation:CTPS foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:CTPS rdf:type owl:Class .
foundation:CTPS rdfs:comment "Carteira de Trabalho e Previdência Social - Brazilian Digital Work Card"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CTPS rdfs:label "CTPS"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CTPS rdfs:seeAlso "\nThe CTPS is the official employment record document in Brazil, which registers\nall employment contracts, salary history, and labor information.\n\nSince 2019, Brazil has adopted the digital CTPS (Carteira de Trabalho Digital),\nwhich is managed through the Carteira de Trabalho Digital app and gov.br portal.\n\nCardinality constraints:\n- documentNumber: exactly 1 (required - CTPS number)\n- pisNumber: exactly 1 (required - PIS/PASEP/NIT number)\n- issueDate: exactly 1 (required - issue date)\n- seriesNumber: 0-1 (optional series number for physical cards)\n\nExample:\n  :johnCTPS a foundation:CTPS ;\n      foundation:documentNumber \"12345678900\" ;\n      foundation:issueDate \"2015-03-10\"^^xsd:date ;\n      foundation:pisNumber \"123.45678.90-1\" ;\n      foundation:seriesNumber \"0001\" .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CTPS rdfs:subClassOf foundation:IdentificationDocument .
foundation:CalculatedField foundation:hasIcon foundation:icon-material-symbols-name-calculate .
foundation:CalculatedField foundation:lastUpdatedAt "2026-03-03T21:22:42Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:CalculatedField rdf:type owl:Class .
foundation:CalculatedField rdfs:comment "A read-only field defined on a concept whose value is automatically computed by the system from a formula. The formula can reference properties of the same instance or related entities using {{property}} or {{relatedEntity.property}} syntax. Values are recalculated on change events and can never be set directly by the AI or user."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CalculatedField rdfs:label "Campo Calculado"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CalculatedField rdfs:subClassOf foundation:AbstractContinuant .
