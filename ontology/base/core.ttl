foundation:fromAccount foundation:lastUpdatedAt "2026-04-10T04:57:36.073489+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:fromAccount rdf:type owl:ObjectProperty .
foundation:fromAccount rdfs:comment "Conta bancária de débito de onde o pagamento foi efetuado ou de onde a transferência bancária saiu. Usado para vincular transações importadas do extrato bancário à conta de origem.\n\naiBehaviorRules: Todo Payment com paidBy=ThisUser (saída de caixa real) DEVE ter fromAccount linkado à conta bancária correspondente. Cartão de crédito NÃO é conta bancária para este efeito — compras no cartão não têm fromAccount; somente o pagamento da fatura (que sai da conta corrente) tem fromAccount. Receitas (paidTo=ThisUser) usam toAccount ou ficam sem fromAccount. Ao importar extratos bancários, sempre vincular fromAccount de todos os lançamentos de saída."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:fromAccount rdfs:domain foundation:BankTransfer .
foundation:fromAccount rdfs:domain foundation:Payment .
foundation:fromAccount rdfs:label "Conta de Origem"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:fromAccount rdfs:range foundation:BankAccount .
foundation:fromAccount rdfs:seeAlso "\nExample:\n  :transfer1 foundation:fromAccount :myAccount .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:fromLibrary foundation:isSystemLocked "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
