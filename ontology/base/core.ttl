unit:BAR qudt:dbpediaMatch "http://dbpedia.org/resource/Bar"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
unit:BAR qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0> .
