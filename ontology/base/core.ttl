qudt:QuantityKindDimensionVector_CGS-LH rdfs:label "CGS LH Dimension vector"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:QuantityKindDimensionVector_CGS-LH rdfs:subClassOf qudt:QuantityKindDimensionVector_CGS .
