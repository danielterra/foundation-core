foundation:hasResponse rdfs:domain foundation:HTTPRequest .
foundation:hasResponse rdfs:label "Tem Resposta"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasResponse rdfs:range foundation:HTTPResponse .
