foundation:RawDataRecord foundation:hasIcon foundation:icon-material-symbols-name-receipt_long .
foundation:RawDataRecord rdf:type owl:Class .
foundation:RawDataRecord rdfs:comment "Staging record that holds the raw payload received from an external source before transformation. Never discarded on failure — rawPayload or rawFile remains intact to allow reprocessing."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RawDataRecord rdfs:label "Raw Data Record"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RawDataRecord rdfs:subClassOf foundation:AbstractContinuant .
