unit:GT rdf:type qudt:Unit .
unit:GT rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit> .
unit:GT rdfs:label "Gross Tonnage"@en .
unit:GT rdfs:seeAlso unit:TON_Register .
