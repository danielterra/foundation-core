foundation:triageOutcome rdfs:domain foundation:EmailTriageRun .
foundation:triageOutcome rdfs:label "Resultado da triagem"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:triageOutcome rdfs:range xsd:string .
