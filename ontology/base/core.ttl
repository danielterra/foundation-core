foundation:timeCycle rdf:type owl:DatatypeProperty .
foundation:timeCycle rdfs:comment "Cron expression for recurring schedule. Uses 6-field syntax required by the Rust `cron` crate: second minute hour day-of-month month day-of-week. Example: '0 0 * * * *' fires every hour on the hour; '0 30 9 * * 1-5' fires at 09:30 on weekdays. NOTE: standard 5-field Unix cron (without the leading seconds field) will silently fail to parse and the timer will not run."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:timeCycle rdfs:domain foundation:automation_TimerEventDefinition .
foundation:timeCycle rdfs:label "Ciclo de Tempo"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:timeCycle rdfs:range xsd:string .
