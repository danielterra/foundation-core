foundation:hasExperience rdfs:domain foundation:Person .
foundation:hasExperience rdfs:label "Tem Experiência"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasExperience rdfs:range foundation:ProfessionalExperience .
