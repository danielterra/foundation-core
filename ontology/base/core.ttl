foundation:FinancialInstitution rdf:type owl:Class .
foundation:FinancialInstitution rdfs:comment "Banking and financial services organizations"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:FinancialInstitution rdfs:label "Instituição Financeira"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:FinancialInstitution rdfs:seeAlso "\nRepresents a bank, credit union, or other financial institution.\n\nExamples:\n- Bank of America\n- Chase\n- Wells Fargo\n- Itaú (Brazil)\n- Banco do Brasil\n- Credit unions\n\nCardinality constraints:\n- bankName: exactly 1 (required)\n- bankCode: max 1 (optional)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:FinancialInstitution rdfs:subClassOf foundation:Organization .
