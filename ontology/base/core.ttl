foundation:Material foundation:hasIcon foundation:icon-material-symbols-name-texture .
foundation:Material foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Material rdf:type owl:Class .
foundation:Material rdfs:comment "Physical things that do not act autonomously"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Material rdfs:label "Material"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Material rdfs:seeAlso "\nExamples:\n- A desk (furniture)\n- A server rack (hardware infrastructure)\n- A keyboard (input device)\n- Raw materials (wood, metal)\n- A printed document\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Material rdfs:subClassOf foundation:ConcreteContinuant .
foundation:Meal foundation:hasIcon foundation:icon-material-symbols-name-restaurant .
foundation:Meal foundation:lastUpdatedAt "2026-03-01T19:43:04Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Meal rdf:type owl:Class .
foundation:Meal rdfs:comment "A meal shared between people"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Meal rdfs:label "Refeição"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Meal rdfs:subClassOf foundation:SocialEvent .
foundation:MediaAnalysis foundation:hasIcon foundation:icon-material-symbols-name-analytics .
foundation:MediaAnalysis rdf:type owl:Class .
foundation:MediaAnalysis rdfs:comment "Represents the result of analyzing a media file (image, video, PDF) via a vision/language model. Stores the textual description generated by the model plus metadata about the analysis. When deleted, the associated file is also cleaned up."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MediaAnalysis rdfs:label "Media Analysis"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MediaAnalysis rdfs:subClassOf foundation:Occurrent .
foundation:MediaRefBlock foundation:hasIcon foundation:icon-material-symbols-name-attachment .
foundation:MediaRefBlock rdf:type owl:Class .
foundation:MediaRefBlock rdfs:comment "Bloco de referência a mídia (imagem ou arquivo) em mensagens de chat"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MediaRefBlock rdfs:label "Media Ref Block"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MediaRefBlock rdfs:subClassOf foundation:ContentBlock .
foundation:MedicalOrder foundation:allowedStatus foundation:Completed .
foundation:MedicalOrder foundation:allowedStatus foundation:InProgress .
foundation:MedicalOrder foundation:allowedStatus foundation:Pending .
foundation:MedicalOrder foundation:hasIcon foundation:icon-material-symbols-name-assignment .
foundation:MedicalOrder rdf:type owl:Class .
foundation:MedicalOrder rdfs:comment "Solicitação de exames, procedimentos ou avaliações emitida por um médico para um paciente. Documento clínico que enumera os exames/procedimentos a serem realizados, com data, prescritor e paciente. Pode ter um arquivo (PDF) anexado com o pedido original."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MedicalOrder rdfs:label "Pedido Médico"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MedicalOrder rdfs:subClassOf foundation:AbstractContinuant .
foundation:Medication foundation:hasIcon foundation:icon-material-symbols-name-medication .
foundation:Medication foundation:lastUpdatedAt "2026-03-19T02:32:46Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Medication rdf:type owl:Class .
foundation:Medication rdfs:comment "Um medicamento prescrito, com nome, dose e frequência."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Medication rdfs:label "Medicamento"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Medication rdfs:subClassOf foundation:AbstractContinuant .
foundation:MediumPriority foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MediumPriority rdf:type foundation:TaskPriority .
foundation:MediumPriority rdfs:label "Medium Priority"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Meeting foundation:allowedStatus foundation:InProgress .
foundation:Meeting foundation:hasIcon foundation:icon-material-symbols-name-groups .
foundation:Meeting foundation:lastUpdatedAt "2026-03-02T13:10:46Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Meeting rdf:type owl:Class .
foundation:Meeting rdfs:comment "A scheduled meeting between people, online or in-person"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Meeting rdfs:label "Reunião"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Meeting rdfs:subClassOf foundation:SocialEvent .
foundation:Memory foundation:hasIcon foundation:icon-material-symbols-name-memory .
foundation:Memory foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:Memory foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Memory rdf:type owl:Class .
foundation:Memory rdfs:comment "Random Access Memory (RAM) module for volatile data storage"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Memory rdfs:label "Memória"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Memory rdfs:seeAlso "\nExamples:\n- 16GB DDR5-5600 SODIMM\n- 32GB DDR4-3200 DIMM\n- 8GB LPDDR5\n\nCardinality constraints:\n- memoryCapacity: exactly 1 (required specification)\n- memoryType: exactly 1 (required specification)\n- memorySpeed: 0-1 (optional frequency specification)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Memory rdfs:subClassOf foundation:ConcreteContinuant .
foundation:MentalHealthCondition foundation:hasIcon foundation:icon-material-symbols-name-psychology .
foundation:MentalHealthCondition foundation:lastUpdatedAt "2026-03-19T02:32:46Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MentalHealthCondition rdf:type owl:Class .
foundation:MentalHealthCondition rdfs:comment "Um diagnóstico ou condição de saúde mental de uma pessoa."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MentalHealthCondition rdfs:label "Condição de Saúde Mental"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MentalHealthCondition rdfs:subClassOf foundation:AbstractQuality .
foundation:MentalHealthDiaryEntry foundation:aiBehaviorRules "Ao iniciar o diário noturno, conduzir como conversa livre e natural — não como formulário. Perguntar como foi o dia de forma aberta, deixar Daniel falar, e ao final extrair os dados estruturados (humor, ansiedade, energia, sono, eventos) da conversa para preencher os campos. Nunca pedir os números diretamente de cara. Tom: presente, curioso, sem julgamento."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MentalHealthDiaryEntry foundation:allowedStatus foundation:Completed .
foundation:MentalHealthDiaryEntry foundation:allowedStatus foundation:Pending .
foundation:MentalHealthDiaryEntry foundation:hasIcon foundation:icon-material-symbols-name-book .
foundation:MentalHealthDiaryEntry foundation:lastUpdatedAt "2026-03-19T02:32:47Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MentalHealthDiaryEntry rdf:type owl:Class .
foundation:MentalHealthDiaryEntry rdfs:comment "Registro diário de saúde mental — humor, energia, sono, ansiedade, reflexões livres."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MentalHealthDiaryEntry rdfs:label "Diário de Saúde Mental"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MentalHealthDiaryEntry rdfs:subClassOf foundation:AbstractContinuant .
foundation:MermaidDiagram foundation:allowedStatus foundation:Completed .
foundation:MermaidDiagram foundation:allowedStatus foundation:InProgress .
foundation:MermaidDiagram foundation:allowedStatus foundation:Pending .
foundation:MermaidDiagram foundation:hasIcon foundation:icon-material-symbols-name-account_tree .
foundation:MermaidDiagram foundation:lastUpdatedAt "2026-03-07T19:09:07Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MermaidDiagram rdf:type owl:Class .
foundation:MermaidDiagram rdfs:comment "A diagram defined in Mermaid syntax. Can be displayed on the blackboard via the mermaid widget."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MermaidDiagram rdfs:label "Diagrama Mermaid"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MermaidDiagram rdfs:subClassOf foundation:AbstractContinuant .
foundation:Message foundation:allowedStatus foundation:Completed .
foundation:Message foundation:allowedStatus foundation:Pending .
foundation:Message foundation:hasIcon foundation:icon-material-symbols-name-chat_bubble .
foundation:Message foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Message rdf:type owl:Class .
foundation:Message rdfs:comment "A discrete unit of communication from one sender to one or more receivers, transmitted through a medium. Can contain text, audio, video, images, or files."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Message rdfs:label "Mensagem"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Message rdfs:seeAlso "\nExamples:\n- Text: User asks AI \"What is 2+2?\"\n- Audio: Voice message in WhatsApp\n- Video: Video message sent via chat\n- Image: Photo shared in conversation\n- File: PDF document attached to email\n- Mixed: Email with text + attachments\n\nCardinality constraints:\n- sender: exactly 1 (who sent it)\n- receiver: 0-N (can have multiple receivers)\n- sentAt: exactly 1 (timestamp)\n- content: 0-1 (text content, optional)\n- hasAttachment: 0-N (audio, video, images, files)\n- transmittedVia: 0-1 (optional medium/channel)\n- partOfConversation: 0-1 (optional conversation grouping)\n- messageType: 0-1 (text, audio, video, image, file, mixed)\n\nNote: At least one of 'content' or 'hasAttachment' should be present.\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Message rdfs:subClassOf foundation:AbstractContinuant .
foundation:MessageEventDefinition rdf:type owl:Class .
foundation:MetaAbstractEvent foundation:hasIcon foundation:icon-material-symbols-name-circle .
foundation:MetaAbstractEvent foundation:lastUpdatedAt "2026-03-14T23:37:07Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaAbstractEvent rdf:type owl:Class .
foundation:MetaAbstractEvent rdfs:comment "Abstract base for all event types in a MetaProcess. Events mark significant moments — the start, an intermediate trigger, or the end. All events carry a triggerType (MetaEventTrigger) that classifies what external source fires them."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaAbstractEvent rdfs:label "MetaAbstractEvent"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaAbstractEvent rdfs:subClassOf foundation:MetaFlowNode .
foundation:MetaAbstractGateway foundation:hasIcon foundation:icon-material-symbols-name-device_hub .
foundation:MetaAbstractGateway foundation:lastUpdatedAt "2026-03-14T23:35:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaAbstractGateway rdf:type owl:Class .
foundation:MetaAbstractGateway rdfs:comment "Abstract base for conditional gateways. Outgoing branches are MetaGatewayCondition nodes. Subclasses differ only in how many branches fire: exactly one (Exclusive), all matching (Inclusive), or first event received (EventBased)."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaAbstractGateway rdfs:label "MetaAbstractGateway"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaAbstractGateway rdfs:subClassOf foundation:MetaFlowNode .
foundation:MetaAbstractTask rdf:type owl:Class .
foundation:MetaBoundaryCondition foundation:hasIcon foundation:icon-material-symbols-name-crisis_alert .
foundation:MetaBoundaryCondition foundation:lastUpdatedAt "2026-03-15T04:13:33Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaBoundaryCondition rdf:type owl:Class .
foundation:MetaBoundaryCondition rdfs:comment "One error-catch branch of a task. Mirrors MetaGatewayCondition — holds the condition that triggers the catch (conditionOperator + conditionValue) and routes to the handler via nextNode."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaBoundaryCondition rdfs:label "MetaBoundaryCondition"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaBoundaryCondition rdfs:subClassOf foundation:AbstractContinuant .
foundation:MetaBoundaryEvent foundation:hasIcon foundation:icon-material-symbols-name-crisis_alert .
foundation:MetaBoundaryEvent foundation:lastUpdatedAt "2026-03-15T01:12:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaBoundaryEvent rdf:type owl:Class .
foundation:MetaBoundaryEvent rdfs:comment "An exception catch node attached to a task via boundaryCondition (as a MetaBoundaryCondition). Fires when a specific condition arises during task execution (error, timer, signal, or message), interrupting the host task and routing to nextNode. Responsible only for the event type — routing logic is in MetaBoundaryCondition. The eventType property determines the icon."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaBoundaryEvent rdfs:label "MetaBoundaryEvent"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaBoundaryEvent rdfs:subClassOf foundation:MetaFlowNode .
foundation:MetaConcept rdf:type owl:Class .
foundation:MetaEndEvent foundation:allowedStatus foundation:Completed .
foundation:MetaEndEvent foundation:allowedStatus foundation:InProgress .
foundation:MetaEndEvent foundation:allowedStatus foundation:Pending .
foundation:MetaEndEvent foundation:hasIcon foundation:icon-material-symbols-name-stop_circle .
foundation:MetaEndEvent foundation:lastUpdatedAt "2026-03-13T02:13:05Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaEndEvent rdf:type owl:Class .
foundation:MetaEndEvent rdfs:comment "The terminal node of a MetaProcess. Marks where the process concludes. A process may have multiple end events representing different outcomes (e.g. AppStop, Cancelled)."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaEndEvent rdfs:label "MetaEndEvent"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaEndEvent rdfs:subClassOf foundation:MetaAbstractEvent .
foundation:MetaEventBasedGateway foundation:hasIcon foundation:icon-material-symbols-name-sensors .
foundation:MetaEventBasedGateway foundation:lastUpdatedAt "2026-03-14T23:11:05Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaEventBasedGateway rdf:type owl:Class .
foundation:MetaEventBasedGateway rdfs:comment "A gateway that waits for the first of several events to arrive and follows the matching branch. Outgoing branches are MetaGatewayCondition nodes whose conditionValue identifies the triggering event name."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaEventBasedGateway rdfs:label "MetaEventBasedGateway"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaEventBasedGateway rdfs:subClassOf foundation:MetaAbstractGateway .
foundation:MetaEventConcept foundation:hasIcon foundation:icon-material-symbols-name-bolt .
foundation:MetaEventConcept foundation:lastUpdatedAt "2026-03-15T02:06:27Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaEventConcept rdf:type owl:Class .
foundation:MetaEventConcept rdfs:comment "A typed data contract flowing through a MetaProcess graph. Used as metaInput and metaOutput on all MetaFlowNode instances to define what concept a node expects to receive and what concept it produces. Represents the design-level specification of data — always a reference to an OWL class, never a raw primitive."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaEventConcept rdfs:label "MetaEventConcept"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaEventConcept rdfs:subClassOf foundation:AbstractContinuant .
foundation:MetaEventTrigger foundation:hasIcon foundation:icon-material-symbols-name-sensors .
foundation:MetaEventTrigger foundation:lastUpdatedAt "2026-03-15T02:21:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaEventTrigger rdf:type owl:Class .
foundation:MetaEventTrigger rdfs:comment "A controlled-vocabulary trigger mechanism that causes a MetaStartEvent or MetaIntermediateEvent to fire. Classifies the external source of the event."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaEventTrigger rdfs:label "MetaEventTrigger"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaEventTrigger rdfs:subClassOf foundation:AbstractContinuant .
foundation:MetaExclusiveGateway foundation:allowedStatus foundation:Completed .
foundation:MetaExclusiveGateway foundation:allowedStatus foundation:InProgress .
foundation:MetaExclusiveGateway foundation:allowedStatus foundation:Pending .
foundation:MetaExclusiveGateway foundation:hasIcon foundation:icon-material-symbols-name-call_split .
foundation:MetaExclusiveGateway foundation:lastUpdatedAt "2026-03-13T02:13:05Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaExclusiveGateway rdf:type owl:Class .
foundation:MetaExclusiveGateway rdfs:comment "A decision node where exactly one outgoing branch is taken. Outgoing branches are MetaGatewayCondition nodes; the one whose conditionValue matches the runtime result is followed."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaExclusiveGateway rdfs:label "MetaExclusiveGateway"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaExclusiveGateway rdfs:subClassOf foundation:MetaAbstractGateway .
foundation:MetaFlowNode foundation:allowedStatus foundation:Completed .
foundation:MetaFlowNode foundation:allowedStatus foundation:InProgress .
foundation:MetaFlowNode foundation:allowedStatus foundation:Pending .
foundation:MetaFlowNode foundation:hasIcon foundation:icon-material-symbols-name-radio_button_unchecked .
foundation:MetaFlowNode foundation:lastUpdatedAt "2026-03-13T02:13:04Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaFlowNode rdf:type owl:Class .
foundation:MetaFlowNode rdfs:comment "Abstract base for all nodes in a MetaProcess flow graph. Every concept in the process (events, tasks, gateways, conditions, boundary events) extends this class."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaFlowNode rdfs:label "MetaFlowNode"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaFlowNode rdfs:subClassOf foundation:AbstractContinuant .
foundation:MetaGatewayCondition rdf:type owl:Class .
foundation:MetaGatewayConditionOperator foundation:hasIcon foundation:icon-material-symbols-name-compare .
foundation:MetaGatewayConditionOperator foundation:lastUpdatedAt "2026-03-15T01:38:52Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaGatewayConditionOperator rdf:type owl:Class .
foundation:MetaGatewayConditionOperator rdfs:comment "A controlled-vocabulary operator used in a MetaGatewayCondition to express how the conditionValue is evaluated at runtime."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaGatewayConditionOperator rdfs:label "MetaGatewayConditionOperator"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaGatewayConditionOperator rdfs:subClassOf foundation:AbstractQuality .
foundation:MetaInclusiveGateway foundation:hasIcon foundation:icon-material-symbols-name-merge .
foundation:MetaInclusiveGateway foundation:lastUpdatedAt "2026-03-15T01:12:50Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaInclusiveGateway rdf:type owl:Class .
foundation:MetaInclusiveGateway rdfs:comment "An OR-split gateway that activates all outgoing branches whose conditions evaluate to true. Outgoing branches are MetaGatewayCondition nodes. One or more branches may fire simultaneously."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaInclusiveGateway rdfs:label "MetaInclusiveGateway"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaInclusiveGateway rdfs:subClassOf foundation:MetaAbstractGateway .
foundation:MetaIntermediateEvent foundation:allowedStatus foundation:Completed .
foundation:MetaIntermediateEvent foundation:allowedStatus foundation:InProgress .
foundation:MetaIntermediateEvent foundation:allowedStatus foundation:Pending .
foundation:MetaIntermediateEvent foundation:hasIcon foundation:icon-material-symbols-name-bolt .
foundation:MetaIntermediateEvent foundation:lastUpdatedAt "2026-03-14T21:35:26Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaIntermediateEvent rdf:type owl:Class .
foundation:MetaIntermediateEvent rdfs:comment "An event that occurs during a process. Has two modelling patterns: (1) Independent — fires at any time after a milestone, not on the fixed sequence; (2) Catching — when a task leads to this event, the flow waits at that point until the trigger fires before continuing. Used as the exclusive communication channel between a MetaSubProcess and its parent, and to model any externally-triggered signal. Does not require a loop-back from downstream tasks — the event re-fires independently on each new trigger."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaIntermediateEvent rdfs:label "MetaIntermediateEvent"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaIntermediateEvent rdfs:subClassOf foundation:MetaAbstractEvent .
foundation:MetaParallelGateway foundation:allowedStatus foundation:Completed .
foundation:MetaParallelGateway foundation:allowedStatus foundation:InProgress .
foundation:MetaParallelGateway foundation:allowedStatus foundation:Pending .
foundation:MetaParallelGateway foundation:hasIcon foundation:icon-material-symbols-name-account_tree .
foundation:MetaParallelGateway foundation:lastUpdatedAt "2026-03-13T02:13:05Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaParallelGateway rdf:type owl:Class .
foundation:MetaParallelGateway rdfs:comment "A fork node that activates all outgoing paths simultaneously without conditions. Uses nextNode directly — no MetaGatewayCondition nodes. Rendered as a circle with a + symbol to distinguish it from conditional gateways."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaParallelGateway rdfs:label "MetaParallelGateway"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaParallelGateway rdfs:subClassOf foundation:MetaFlowNode .
foundation:MetaProcess rdf:type owl:Class .
foundation:MetaProcessGraphRequest rdf:type owl:Class .
foundation:MetaProcessGraphResult rdf:type owl:Class .
foundation:MetaProperty foundation:allowedStatus foundation:Completed .
foundation:MetaProperty foundation:allowedStatus foundation:InProgress .
foundation:MetaProperty foundation:allowedStatus foundation:Pending .
foundation:MetaProperty foundation:hasIcon foundation:icon-material-symbols-name-link .
foundation:MetaProperty foundation:lastUpdatedAt "2026-03-12T22:25:26Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:MetaProperty rdf:type owl:Class .
foundation:MetaProperty rdfs:comment "Meta-representation of an OWL Property. Allows properties to be treated as first-class entities that can be related to Concepts, Features, etc."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaProperty rdfs:label "MetaProperty"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:MetaProperty rdfs:subClassOf foundation:AbstractContinuant .
foundation:MetaShould rdf:type owl:Class .
foundation:MetaStartEvent foundation:allowedStatus foundation:Completed .
