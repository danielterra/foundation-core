foundation:hasEmailAddress rdfs:seeAlso "\nAn entity can have multiple email addresses (personal, work, support, sales, etc.).\n\nCan be used with:\n- foundation:Person (personal or work email)\n- foundation:Company or foundation:Organization (business email)\n\nExamples:\n  :john foundation:hasEmailAddress :johnPersonalEmail ;\n        foundation:hasEmailAddress :johnWorkEmail ;\n        foundation:hasEmailAddress :johnGitHubEmail .\n\n  :acmeCompany foundation:hasEmailAddress :acmeContactEmail ;\n               foundation:hasEmailAddress :acmeSupportEmail ;\n               foundation:hasEmailAddress :acmeSalesEmail .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasEndTime rdf:type owl:DatatypeProperty .
