foundation:CommunicationMedium foundation:hasIcon foundation:icon-material-symbols-name-sensors .
foundation:CommunicationMedium foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:CommunicationMedium rdf:type owl:Class .
foundation:CommunicationMedium rdfs:comment "The channel, platform, or means through which a message is transmitted. Can be a software application, telecom service, physical delivery, or group/channel within a platform."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CommunicationMedium rdfs:label "Canal de Comunicação"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CommunicationMedium rdfs:seeAlso "\nExamples by Type:\n\nSoftware Applications (providedBy → Application/Service):\n- FOUNDATION Chat Interface (internal app)\n- WhatsApp (messaging app, can have groups)\n- Gmail (email service)\n- Slack (team communication, has channels)\n- Telegram (messaging app, has channels and groups)\n- Microsoft Teams (collaboration platform)\n\nTelecommunication Services (providedBy → TelecommunicationProvider):\n- SMS via Vivo (text messaging through carrier)\n- Voice Call via Claro (phone call through carrier)\n- SMS via AT&T (international SMS)\n- Voice Call via T-Mobile (voice service)\n\nPhysical Delivery:\n- Postal service (letters, packages)\n- Courier service (DHL, FedEx)\n- Hand delivery (in-person)\n\nGroups/Channels (providedBy → parent application):\n- WhatsApp Group \"Family\" (group within WhatsApp)\n- Slack channel #general (channel within Slack workspace)\n- Telegram channel \"News\" (broadcast channel)\n\nSubtypes (suggested):\n- DigitalCommunicationMedium: chat apps, email, forums\n- PhysicalCommunicationMedium: postal mail, courier\n- TelecommunicationMedium: SMS, voice calls via carriers\n- BroadcastMedium: TV, radio, public channels\n\nUse Cases:\n- Track which platform/service a message was sent through\n- Model groups/channels as mediums within applications\n- Distinguish between SMS via Vivo vs. WhatsApp message\n- Link messages to telecommunication providers (for billing, analytics)\n- Separate application-level mediums from network-level carriers\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CommunicationMedium rdfs:subClassOf foundation:AbstractQuality .
foundation:CompactionSummaryBlock foundation:hasIcon foundation:icon-material-symbols-name-summarize .
foundation:CompactionSummaryBlock rdf:type owl:Class .
foundation:CompactionSummaryBlock rdfs:comment "Bloco de conteúdo que preserva um resumo de contexto quando o histórico de uma conversa é compactado."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CompactionSummaryBlock rdfs:label "Bloco de Resumo de Compactação"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:CompactionSummaryBlock rdfs:subClassOf foundation:ContentBlock .
foundation:Company foundation:hasIcon foundation:icon-material-symbols-name-business .
foundation:Company foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:Company foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Company rdf:type owl:Class .
foundation:Company rdfs:comment "An employer organization with legal registration (CNPJ in Brazil). Subclass of Organization — every Company IS an Organization."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Company rdfs:label "Empresa"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Company rdfs:seeAlso "\nRepresents a company or employer organization that can hire employees.\n\nCardinality constraints:\n- organizationName: exactly 1 (required - legal name is mandatory)\n- cnpj: 0-1 (CNPJ tax ID)\n- tradeName: 0-1 (trade/brand name)\n- foundingDate: 0-1 (founding date)\n- mainActivity: 0-1 (main CNAE activity)\n- companySize: 0-1 (ME, EPP, etc.)\n- legalNature: 0-1 (legal nature classification)\n- shareCapital: 0-1 (capital social)\n- registrationNumber: 0-1 (NIRE registration)\n\nExample:\n  :acmeCompany a foundation:Company ;\n      foundation:organizationName \"ACME Corporation Ltda\" ;\n      foundation:cnpj \"12.345.678/0001-90\" ;\n      foundation:hasAddress :acmeAddress .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Company rdfs:subClassOf foundation:AbstractContinuant .
foundation:Company rdfs:subClassOf foundation:AgentCapacity .
foundation:Company rdfs:subClassOf foundation:Organization .
foundation:Completed foundation:color "#4CAF50"^^<http://foundation.local/ontology/HexColor> .
foundation:Completed foundation:hasIcon foundation:icon-material-symbols-name-check_circle .
foundation:Completed foundation:lastUpdatedAt "2026-04-10T14:55:22.461596+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Completed foundation:parentStatus foundation:Completed .
foundation:Completed rdf:type foundation:Status .
foundation:Completed rdfs:comment "Successfully finished"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Completed rdfs:label "Concluído"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:Computer foundation:hasIcon foundation:icon-material-symbols-name-computer .
foundation:Computer foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:Computer foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Computer rdf:type owl:Class .
foundation:Computer rdfs:comment "A programmable electronic device for processing and storing data"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Computer rdfs:label "Computador"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Computer rdfs:seeAlso "\nExamples:\n- A laptop (MacBook Pro)\n- A server (AWS EC2 instance physical hardware)\n- A smartphone (iPhone, Android)\n- A desktop workstation\n- An embedded system (Raspberry Pi)\n\nCardinality constraints:\n- hasProcessor: at least 1 (servers may have multiple CPUs)\n- hasMemory: at least 1 (may have multiple RAM modules)\n- hasStorage: at least 1 (may have multiple drives)\n- hasOperatingSystem: exactly 1 (only one OS running)\n- hostname: max 1 (unique network identifier, optional)\n- manufacturer: max 1 (single manufacturer)\n- model: max 1 (single model designation)\n- serialNumber: max 1 (unique serial number)\n- cpuArchitecture: max 1 (e.g., x86_64, ARM64)\n- macAddress: max 1 (primary MAC address)\n- ipAddress: max 1 (primary IP address)\n- hasGraphicsProcessor: 0+ (optional, may have multiple GPUs)\n- hasNetworkInterface: 0+ (optional, may have multiple adapters)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Computer rdfs:subClassOf foundation:ConcreteContinuant .
foundation:Concept rdf:type owl:Class .
foundation:ConceptGraphRequest foundation:hasIcon foundation:icon-material-symbols-name-input .
foundation:ConceptGraphRequest foundation:lastUpdatedAt "2026-03-15T13:15:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConceptGraphRequest rdf:type owl:Class .
foundation:ConceptGraphRequest rdfs:comment "Input interface for the get_concept_graph MCP tool. Defines the root concept and the maximum traversal depth in all directions (outbound and inbound)."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptGraphRequest rdfs:label "Concept Graph Request"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptGraphRequest rdfs:subClassOf foundation:AbstractContinuant .
foundation:ConceptGraphRequest rdfs:subClassOf _:restriction_629c4ccd72284b8e .
foundation:ConceptGraphRequest rdfs:subClassOf _:restriction_8677e121102fb978 .
foundation:ConceptGraphResult foundation:hasIcon foundation:icon-material-symbols-name-hub .
foundation:ConceptGraphResult foundation:lastUpdatedAt "2026-03-15T13:15:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConceptGraphResult rdf:type owl:Class .
foundation:ConceptGraphResult rdfs:comment "Output interface for the get_concept_graph MCP tool. Contains the full relational graph of a concept — all outbound properties (domain → range) and inbound references (backlinks) up to the requested depth."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptGraphResult rdfs:label "Concept Graph Result"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptGraphResult rdfs:subClassOf foundation:AbstractContinuant .
foundation:ConceptGraphResult rdfs:subClassOf _:restriction_9c37a97f95b24661 .
foundation:ConceptGraphResult rdfs:subClassOf _:restriction_f95d49ec9f44e38d .
foundation:ConceptScope foundation:hasIcon foundation:icon-material-symbols-name-category .
foundation:ConceptScope foundation:lastUpdatedAt "2026-03-07T18:12:18Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConceptScope rdf:type owl:Class .
foundation:ConceptScope rdfs:comment "Concept scope — event triggers on all instances of a specific concept."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptScope rdfs:label "Concept Scope"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptScope rdfs:subClassOf foundation:EventScope .
foundation:ConceptSubgraphRequest foundation:hasIcon foundation:icon-material-symbols-name-input .
foundation:ConceptSubgraphRequest foundation:lastUpdatedAt "2026-03-15T12:39:27Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConceptSubgraphRequest rdf:type owl:Class .
foundation:ConceptSubgraphRequest rdfs:comment "Input interface for the get_concept_subgraph MCP tool. Defines the root concept IRI and the maximum traversal depth."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptSubgraphRequest rdfs:label "Concept Subgraph Request"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptSubgraphRequest rdfs:subClassOf foundation:AbstractContinuant .
foundation:ConceptSubgraphRequest rdfs:subClassOf _:restriction_2451c9852b75ef6b .
foundation:ConceptSubgraphRequest rdfs:subClassOf _:restriction_31cc7364042960ad .
foundation:ConceptSubgraphResult foundation:hasIcon foundation:icon-material-symbols-name-account_tree .
foundation:ConceptSubgraphResult foundation:lastUpdatedAt "2026-03-15T12:39:27Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConceptSubgraphResult rdf:type owl:Class .
foundation:ConceptSubgraphResult rdfs:comment "Output interface for the get_concept_subgraph MCP tool. Contains the traversed subgraph as serialized nodes and edges."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptSubgraphResult rdfs:label "Concept Subgraph Result"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConceptSubgraphResult rdfs:subClassOf foundation:GraphResult .
foundation:ConcreteContinuant foundation:hasIcon foundation:icon-material-symbols-name-inventory_2 .
foundation:ConcreteContinuant rdf:type owl:Class .
foundation:ConcreteContinuant rdfs:comment "Atalho de interseção: ConcreteThing ∩ Continuant.\n\nCoisas físicas/tangíveis que persistem inteiras no tempo. Não tem propriedades próprias — herda de ConcreteThing e Continuant.\n\nUse como pai direto de classes que representem objetos físicos com identidade.\n\nExemplos típicos: Person, Computer, Memory, Processor, NetworkInterface, StorageDevice."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConcreteContinuant rdfs:label "Concrete Continuant"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConcreteContinuant rdfs:subClassOf foundation:ConcreteThing .
foundation:ConcreteContinuant rdfs:subClassOf foundation:Continuant .
foundation:ConcreteOccurrent foundation:hasIcon foundation:icon-material-symbols-name-directions_run .
foundation:ConcreteOccurrent rdf:type owl:Class .
foundation:ConcreteOccurrent rdfs:comment "Atalho de interseção: ConcreteThing ∩ Occurrent.\n\nEventos físicos com início e fim no tempo. Raros, mas necessários para modelar ocorrências corporais/materiais.\n\nUse como pai direto de classes que representem eventos físicos pontuais (a aula em si, a corrida que aconteceu).\n\nExemplos típicos: ocorrências específicas de aula de academia, eventos físicos pontuais."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConcreteOccurrent rdfs:label "Concrete Occurrent"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConcreteOccurrent rdfs:subClassOf foundation:ConcreteThing .
foundation:ConcreteOccurrent rdfs:subClassOf foundation:Occurrent .
foundation:ConcreteThing foundation:hasIcon foundation:icon-material-symbols-name-widgets .
foundation:ConcreteThing foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConcreteThing owl:disjointWith foundation:AbstractThing .
foundation:ConcreteThing rdf:type owl:Class .
foundation:ConcreteThing rdfs:comment "Things that exist in physical form and occupy space in time. Concrete things have tangible, measurable properties and can be directly perceived or located."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConcreteThing rdfs:label "Concrete Thing"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConcreteThing rdfs:seeAlso "\nExamples:\n- A person (Daniel Terra)\n- A computer (MacBook Pro)\n- A file (FOUNDATION.db)\n- A building (your house)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConcreteThing rdfs:subClassOf owl:Thing .
foundation:ConnectorCapability foundation:hasIcon foundation:icon-material-symbols-name-extension .
foundation:ConnectorCapability foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:ConnectorCapability foundation:lastUpdatedAt "2026-03-08T14:53:19Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConnectorCapability rdf:type owl:Class .
foundation:ConnectorCapability rdfs:comment "A named capability of an external service connector (e.g. Send Email, List Messages, Create Issue). Groups one or more ConnectorEndpoints into a logical operation."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConnectorCapability rdfs:label "Connector Capability"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConnectorCapability rdfs:subClassOf foundation:AbstractQuality .
foundation:ConnectorEndpoint foundation:hasIcon foundation:icon-material-symbols-name-api .
foundation:ConnectorEndpoint foundation:lastUpdatedAt "2026-03-08T14:53:11Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConnectorEndpoint rdf:type owl:Class .
foundation:ConnectorEndpoint rdfs:comment "Describes one HTTP endpoint of an external service connector, including its path, method, schemas and concept mapping."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConnectorEndpoint rdfs:label "Connector Endpoint"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConnectorEndpoint rdfs:subClassOf foundation:AbstractContinuant .
foundation:ConnectorPackage foundation:hasIcon foundation:icon-material-symbols-name-package_2 .
foundation:ConnectorPackage foundation:lastUpdatedAt "2026-03-08T15:31:41Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ConnectorPackage rdf:type owl:Class .
foundation:ConnectorPackage rdfs:comment "A portable bundle containing an ExternalServiceConnector definition, its ConnectorCapabilities, and related ontology concepts. Can be exported to JSON and imported by other Foundation users."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConnectorPackage rdfs:label "Connector Package"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConnectorPackage rdfs:subClassOf foundation:AbstractContinuant .
foundation:ContentBlock foundation:hasIcon foundation:icon-material-symbols-name-view_module .
foundation:ContentBlock rdf:type owl:Class .
foundation:ContentBlock rdfs:comment "Bloco unitário de conteúdo dentro de uma mensagem ou conversa de IA. Contém metadados de posição (blockIndex) e tipo de mídia (mediaType). Filhas: blocos de texto, imagem, documento, ferramenta, pensamento, etc. Reagrupa as classes que antes penduravam em owl:Thing apenas para usar essas duas propriedades."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ContentBlock rdfs:label "Bloco de Conteúdo"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ContentBlock rdfs:subClassOf foundation:AbstractContinuant .
foundation:Continuant foundation:hasIcon foundation:icon-material-symbols-name-anchor .
foundation:Continuant rdf:type owl:Class .
foundation:Continuant rdfs:comment "Entidades que ESTÃO — existem inteiras em qualquer instante. Persistem no tempo: o estado pode mudar, mas a identidade da coisa continua a mesma.\n\nPergunta-chave: \"Essa entidade inteira existe agora, neste instante?\" — se sim, é Continuant.\n\nNão deve ser usada diretamente como pai. Use os atalhos AbstractContinuant ou ConcreteContinuant.\n\nExemplos: Email (a mensagem está toda lá), Invoice, Contract, Person, Plan, Goal, BankAccount."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Continuant rdfs:label "Continuant"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Continuant rdfs:subClassOf owl:Thing .
foundation:Continuant rdfs:subClassOf _:restriction_2b8b020db62fdbfd .
foundation:Contract foundation:hasIcon foundation:icon-material-symbols-name-description .
foundation:Contract foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Contract owl:imports <http://qudt.org/2.1/vocab/currency> .
foundation:Contract rdf:type owl:Class .
foundation:Contract rdfs:comment "Binding agreement between 2+ AgentCapacities with legal/financial consequences. Generates financial obligations and may create payment requirements. Parent class for specific contract types (Employment, Rental, Service, Loan, Purchase)."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Contract rdfs:label "Contrato"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Contract rdfs:seeAlso "\nA contract is a formal agreement that creates legal obligations between parties.\n\nExamples:\n- Employment contracts\n- Service contracts\n- Sales contracts\n- Rental/lease agreements\n- License agreements\n- Non-disclosure agreements (NDAs)\n\nKey characteristics:\n- Has defined parties (contractor, contractee)\n- Has start and potentially end dates\n- May have financial terms\n- May include specific obligations and deliverables\n\nCardinality Constraints:\n- contractStartDate: exactly 1 (required)\n- contractor: min 1 (required, can have multiple contractors)\n- contractee: min 1 (required, can have multiple contractees)\n- contractNumber: max 1 (optional, single value)\n- contractTitle: max 1 (optional, single value)\n- contractEndDate: max 1 (optional, single value)\n- contractValue: max 1 (optional, single value)\n- contractCurrency: max 1 (optional, single value)\n- contractStatus: max 1 (optional, single value)\n- signatureDate: max 1 (optional, single value)\n- governingLaw: max 1 (optional, single value)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Contract rdfs:subClassOf foundation:AbstractContinuant .
foundation:Conversation foundation:hasIcon foundation:icon-material-symbols-name-forum .
foundation:Conversation foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Conversation rdf:type owl:Class .
foundation:Conversation rdfs:comment "A collection of related messages between participants, forming a dialogue or exchange"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Conversation rdfs:label "Conversa"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Conversation rdfs:seeAlso "\nExamples:\n- Chat conversation with AI assistant\n- WhatsApp group chat thread\n- Email thread/chain\n- Slack channel discussion\n- Phone call transcript\n\nCardinality constraints:\n- startedAt: exactly 1 (when conversation began)\n- endedAt: 0-1 (optional, if conversation has concluded)\n- hasParticipant: 1-N (at least one participant, usually 2+)\n- hasMessage: 0-N (can be empty initially)\n- topic: 0-1 (optional subject/title)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Conversation rdfs:subClassOf foundation:AbstractOccurrent .
foundation:ConversationAnalysisRun foundation:allowedStatus foundation:Completed .
foundation:ConversationAnalysisRun foundation:allowedStatus foundation:InProgress .
foundation:ConversationAnalysisRun foundation:hasIcon foundation:icon-material-symbols-name-nightlight_round .
foundation:ConversationAnalysisRun rdf:type owl:Class .
foundation:ConversationAnalysisRun rdfs:comment "Instância de controle para a automação Análise Noturna de Conversas. Acumula as conversas analisadas e o relatório gerado."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConversationAnalysisRun rdfs:label "Execução de Análise Noturna de Conversas"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ConversationAnalysisRun rdfs:subClassOf foundation:AutomationExecutionControl .
