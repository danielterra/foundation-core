foundation:hasDependency rdfs:domain foundation:ArchitectureLayer .
foundation:hasDependency rdfs:label "Tem Dependência"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasDependency rdfs:range foundation:SoftwareDependency .
