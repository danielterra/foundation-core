foundation:KanbanColumn rdf:type owl:Class .
foundation:KanbanColumn rdfs:comment "A column in a Kanban board representing a stage of work (e.g. Backlog, To Do, In Progress, Review, Done). Has an order and optional WIP limit."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:KanbanColumn rdfs:label "Coluna Kanban"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:KanbanColumn rdfs:subClassOf foundation:AbstractContinuant .
