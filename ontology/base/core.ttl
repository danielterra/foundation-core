foundation:BankTransfer rdfs:comment "A transfer of funds from one bank account to another"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:BankTransfer rdfs:comment "Transfers of funds between bank accounts"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:BankTransfer rdfs:label "Transferência Bancária"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:BankTransfer rdfs:seeAlso "\nRepresents money being moved between bank accounts.\n\nTypes:\n- Domestic transfer (within same country)\n- International/wire transfer (between countries)\n- ACH transfer (US)\n- TED/PIX transfer (Brazil)\n- SEPA transfer (Europe)\n\nExample:\n  :transfer1 a foundation:BankTransfer ;\n      foundation:fromAccount :myCheckingAccount ;\n      foundation:toAccount :myBusinessAccount ;\n      foundation:transactionAmount \"5000.00\"^^xsd:decimal ;\n      foundation:transactionCurrency currency:USD ;\n      foundation:transactionDate \"2024-01-15\"^^xsd:date ;\n      foundation:transferType \"ACH\" ;\n      foundation:transactionStatus \"Completed\" .\n\nCardinality constraints:\n- fromAccount: exactly 1 (required)\n- toAccount: exactly 1 (required)\n- transferType: max 1 (optional)\n- referenceNumber: max 1 (optional)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:BankTransfer rdfs:subClassOf foundation:FinancialTransaction .
