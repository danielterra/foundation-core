foundation:FinancialTransaction foundation:hasIcon foundation:icon-material-symbols-name-swap_horiz .
foundation:FinancialTransaction foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:FinancialTransaction owl:imports <http://qudt.org/2.1/vocab/currency> .
foundation:FinancialTransaction rdf:type owl:Class .
foundation:FinancialTransaction rdfs:comment "A movement of money between accounts or parties"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:FinancialTransaction rdfs:comment "Base class for all financial transactions"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:FinancialTransaction rdfs:label "Transação Financeira"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:FinancialTransaction rdfs:seeAlso "\nBase class for all types of financial transactions.\n\nSubtypes:\n- BankTransfer (between bank accounts)\n- Payment (for goods/services)\n- Invoice (bill for payment)\n- Expense (expenditure record)\n- Income (revenue record)\n\nCardinality constraints:\n- transactionDate: exactly 1 (required)\n- transactionAmount: exactly 1 (required)\n- transactionCurrency: exactly 1 (required)\n- transactionId: max 1 (optional)\n- transactionStatus: max 1 (optional)\n- transactionDescription: max 1 (optional)\n- transactionFee: max 1 (optional)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:FinancialTransaction rdfs:subClassOf foundation:AbstractOccurrent .
