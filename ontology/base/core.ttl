foundation:hasPossibleActions rdfs:domain foundation:Concept .
foundation:hasPossibleActions rdfs:label "Tem Ações Possíveis"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasPossibleActions rdfs:range foundation:Automation .
foundation:hasPreferredEmail foundation:lastUpdatedAt "2026-04-10T03:25:04.691726+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasPreferredEmail rdf:type owl:ObjectProperty .
