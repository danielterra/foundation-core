foundation:Smartphone foundation:hasIcon foundation:icon-material-symbols-name-smartphone .
foundation:Smartphone foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Smartphone rdf:type owl:Class .
foundation:Smartphone rdfs:comment "A mobile computer with touchscreen interface, cellular connectivity, and mobile operating system"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Smartphone rdfs:label "Smartphone"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Smartphone rdfs:seeAlso "\nExamples:\n- iPhone 15 Pro\n- Samsung Galaxy S24\n- Google Pixel 8\n- OnePlus 12\n\nCardinality constraints:\n- hasPhoneNumber: 0-2 (supports no SIM, single SIM, or dual SIM)\n- hasIMEI: exactly 1 (required unique identifier)\n- screenSize: exactly 1 (required specification)\n- hasMobileCarrier: 0-2 (dual SIM devices may have up to 2 carriers)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Smartphone rdfs:subClassOf foundation:Computer .
