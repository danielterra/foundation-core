qudt:BitEncodingType foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:BitEncodingType <http://purl.org/dc/terms/description> "A bit encoding is a correspondence between the two possible values of a bit, 0 or 1, and some interpretation. For example, in a boolean encoding, a bit denotes a truth value, where 0 corresponds to False and 1 corresponds to True."^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:BitEncodingType rdf:type owl:Class .
qudt:BitEncodingType rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:BitEncodingType rdfs:label "Bit Encoding"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:BitEncodingType rdfs:subClassOf qudt:Encoding .
qudt:BooleanEncoding foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:BooleanEncoding qudt:bits "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
qudt:BooleanEncoding rdf:type qudt:BooleanEncodingType .
qudt:BooleanEncoding rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:BooleanEncoding rdfs:label "Boolean Encoding"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:BooleanEncodingType foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:BooleanEncodingType rdf:type owl:Class .
qudt:BooleanEncodingType rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:BooleanEncodingType rdfs:label "Boolean encoding type"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:BooleanEncodingType rdfs:subClassOf qudt:Encoding .
qudt:ByteEncodingType foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:ByteEncodingType <http://purl.org/dc/terms/description> "This class contains the various ways that information may be encoded into bytes."^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:ByteEncodingType rdf:type owl:Class .
qudt:ByteEncodingType rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:ByteEncodingType rdfs:label "Byte Encoding"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:ByteEncodingType rdfs:subClassOf qudt:Encoding .
qudt:CT_COUNTABLY-INFINITE foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:CT_COUNTABLY-INFINITE <http://purl.org/dc/terms/description> "\n  A set of numbers is called countably infinite if there is a way to enumerate them. \n  Formally this is done with a bijection function that associates each number in the set with exactly one of the positive integers.\n  The set of all fractions is also countably infinite.\n  In other words, any set $X$ that has the same cardinality as the set of the natural numbers,\n   or $| X | \\; =  \\; | \\mathbb N | \\; = \\; \\aleph0$, is said to be a countably infinite set.\n  "^^<http://qudt.org/schema/qudt/LatexString> .
qudt:CT_COUNTABLY-INFINITE <http://www.linkedmodel.org/schema/dtype#literal> "countable"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CT_COUNTABLY-INFINITE qudt:informativeReference "http://www.math.vanderbilt.edu/~schectex/courses/infinity.pdf"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:CT_COUNTABLY-INFINITE rdf:type qudt:CardinalityType .
qudt:CT_COUNTABLY-INFINITE rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:CT_COUNTABLY-INFINITE rdfs:label "Countably Infinite Cardinality Type"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CT_FINITE foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:CT_FINITE <http://purl.org/dc/terms/description> "Any set $X$ with cardinality less than that of the natural numbers, or $| X | \\\\; <  \\; | \\\\mathbb N | $, is said to be a finite set."^^<http://qudt.org/schema/qudt/LatexString> .
qudt:CT_FINITE <http://www.linkedmodel.org/schema/dtype#literal> "finite"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CT_FINITE rdf:type qudt:CardinalityType .
qudt:CT_FINITE rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:CT_FINITE rdfs:label "Finite Cardinality Type"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CT_UNCOUNTABLE foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:CT_UNCOUNTABLE <http://purl.org/dc/terms/description> "Any set with cardinality greater than that of the natural numbers, or $| X | \\; >  \\; | \\mathbb N | $,  for example $| R| \\; =  \\;  c  \\; > |\\mathbb N |$, is said to be uncountable."^^<http://qudt.org/schema/qudt/LatexString> .
qudt:CT_UNCOUNTABLE <http://www.linkedmodel.org/schema/dtype#literal> "uncountable"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CT_UNCOUNTABLE rdf:type qudt:CardinalityType .
qudt:CT_UNCOUNTABLE rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:CT_UNCOUNTABLE rdfs:label "Uncountable Cardinality Type"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CardinalityType foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:CardinalityType <http://purl.org/dc/terms/description> "\n  In mathematics, the cardinality of a set is a measure of the number of elements of the set.\n  For example, the set $A = {2, 4, 6}$ contains 3 elements, and therefore $A$ has a cardinality of 3. \n  There are two approaches to cardinality: one which compares sets directly using bijections and injections,\n   and another which uses cardinal numbers.\n  "^^<http://qudt.org/schema/qudt/LatexString> .
qudt:CardinalityType qudt:informativeReference "http://en.wikipedia.org/wiki/Cardinal_number"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:CardinalityType qudt:informativeReference "http://en.wikipedia.org/wiki/Cardinality"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
qudt:CardinalityType qudt:plainTextDescription "In mathematics, the cardinality of a set is a measure of the number of elements of the set.  For example, the set 'A = {2, 4, 6}' contains 3 elements, and therefore 'A' has a cardinality of 3. There are two approaches to cardinality – one which compares sets directly using bijections and injections, and another which uses cardinal numbers."^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CardinalityType rdf:type owl:Class .
qudt:CardinalityType rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:CardinalityType rdfs:label "Cardinality Type"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CardinalityType rdfs:subClassOf qudt:EnumeratedValue .
qudt:CharEncoding foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:CharEncoding <http://purl.org/dc/elements/1.1/description> "7 bits of 1 octet"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CharEncoding qudt:bytes "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
qudt:CharEncoding rdf:type qudt:BooleanEncodingType .
qudt:CharEncoding rdf:type qudt:CharEncodingType .
qudt:CharEncoding rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:CharEncoding rdfs:label "Char Encoding"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CharEncodingType foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:CharEncodingType <http://purl.org/dc/terms/description> "The class of all character encoding schemes, each of which defines a rule or algorithm for encoding character data as a sequence of bits or bytes."^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CharEncodingType rdf:type owl:Class .
qudt:CharEncodingType rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:CharEncodingType rdfs:label "Char Encoding Type"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:CharEncodingType rdfs:subClassOf qudt:Encoding .
qudt:Citation foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:Citation rdf:type owl:Class .
qudt:Citation rdfs:comment "Provides a simple way of making citations."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:Citation rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:Citation rdfs:label "Citation"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:Citation rdfs:subClassOf qudt:Concept .
