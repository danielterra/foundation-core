foundation:hasPreferredEmail rdfs:range foundation:Email .
foundation:hasPreferredEmail rdfs:seeAlso "\nExample:\n  :daniel foundation:hasPreferredEmail :email1 .\n\nNote: owl:FunctionalProperty ensures maximum ONE preferred email.\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasPreferredEmail rdfs:subPropertyOf foundation:hasEmail .
foundation:hasProcessor foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
