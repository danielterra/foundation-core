unit:OHM_Stat qudt:conversionMultiplier "898760000000"^^<http://www.w3.org/2001/XMLSchema#decimal> .
unit:OHM_Stat qudt:conversionMultiplierSN "898760000000"^^<http://www.w3.org/2001/XMLSchema#decimal> .
unit:OHM_Stat qudt:derivedUnitOfSystem <http://qudt.org/vocab/sou/CGS-ESU> .
unit:OHM_Stat qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-3D0> .
unit:OHM_Stat qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Resistance> .
