foundation:Address rdf:type owl:Class .
foundation:Address rdfs:comment "A physical address with references to geographic locations"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Address rdfs:comment "Physical address with references to geographic locations"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Address rdfs:label "Endereço"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Address rdfs:seeAlso "\nExamples:\n- Residential address\n- Business address\n- Mailing address\n- Delivery address\n\nAn address combines a street, number, and geographic hierarchy\nto uniquely identify a physical location.\n\nCardinality constraints:\nAll address components have maxCardinality 1 (single value per component).\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Address rdfs:subClassOf foundation:AbstractContinuant .
foundation:AgentCapacity foundation:hasIcon foundation:icon-material-symbols-name-speed .
foundation:AgentCapacity foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:AgentCapacity rdf:type owl:Class .
foundation:AgentCapacity rdfs:comment "Representa a capacidade de execução de um agente (pessoa, time ou squad) — disponibilidade, throughput e carga de trabalho. Problemas que afetam capacidade apontam para esta classe."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AgentCapacity rdfs:label "Capacidade do Agente"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AgentCapacity rdfs:seeAlso "\nExamples:\n- A person (Daniel Terra) - physical with agent capacity\n- An organization (FOUNDATION Project) - abstract with agent capacity\n- A software system (FOUNDATION AI Assistant) - digital with agent capacity\n- An autonomous robot - physical with agent capacity\n\nNote: This is a CAPACITY (behavior), not a nature. Combine with PhysicalThing,\nDigitalThing, or Concept to create concrete agent types.\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AgentCapacity rdfs:subClassOf foundation:Continuant .
