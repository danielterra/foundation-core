qudt:ISO8601-UTCDateTime-BasicFormat qudt:allowedPattern "[0-9]{4}[0-9]{2}[0-9]{2}T[0-9]{2}[0-9]{2}[0-9]{2}.[0-9]+Z"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:ISO8601-UTCDateTime-BasicFormat qudt:allowedPattern "[0-9]{4}[0-9]{2}[0-9]{2}T[0-9]{2}[0-9]{2}[0-9]{2}Z"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:ISO8601-UTCDateTime-BasicFormat rdf:type qudt:DateTimeStringEncodingType .
