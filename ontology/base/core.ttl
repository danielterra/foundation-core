foundation:PhysicalProduct rdf:type owl:Class .
foundation:PhysicalProduct rdfs:comment "A tangible product that has physical form and can be touched, manufactured, and shipped"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:PhysicalProduct rdfs:label "Produto Físico"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:PhysicalProduct rdfs:seeAlso "\nExamples:\n- iPhone 15 Pro (smartphone model)\n- MacBook Pro M3 (laptop model)\n- Dell XPS 13 (laptop model)\n- Samsung Galaxy S24 (smartphone model)\n\nNote: This represents the PRODUCT MODEL, not individual units.\nIndividual physical instances would be PhysicalThing entities.\n\nCardinality constraints:\n- manufacturedBy: at least 1 (required, physical product must have manufacturer(s))\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:PhysicalProduct rdfs:subClassOf foundation:Product .
foundation:Plan foundation:hasIcon foundation:icon-material-symbols-name-map .
foundation:Plan foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Plan owl:imports foundation:Status .
foundation:Plan rdf:type owl:Class .
foundation:Plan rdfs:comment "A design or intention describing how something should be accomplished, composed of ordered tasks"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Plan rdfs:label "Plano"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Plan rdfs:seeAlso "\nA Plan is the design; Tasks are the execution.\n\nExamples:\n- UI/UX Design Plan for a new onboarding flow\n- Backend Architecture Plan for an authentication service\n- Frontend Architecture Plan for a dashboard\n- Data Architecture Plan for a reporting schema\n- Ontology Plan for a new knowledge domain\n\nPlans can depend on each other. For example, a FrontendArchitecturePlan\ntypically dependsOn a BackendArchitecturePlan, since frontend components\nneed to know the API contract first.\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Plan rdfs:subClassOf foundation:AbstractContinuant .
