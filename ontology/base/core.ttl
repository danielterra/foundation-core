foundation:height rdfs:comment "Height in meters"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:height rdfs:domain foundation:Person .
foundation:height rdfs:label "Altura"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:height rdfs:range xsd:decimal .
foundation:height rdfs:seeAlso "\nExample:\n  :john foundation:height 1.75 .  # 1.75 meters\n"^^<http://www.w3.org/2001/XMLSchema#string> .
