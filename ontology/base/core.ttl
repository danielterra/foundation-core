foundation:hasScreenCaptureInterval rdfs:label "has screen capture interval"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasScreenCaptureInterval rdfs:range xsd:integer .
foundation:hasSegway foundation:isSystemLocked "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:hasSegway foundation:lastUpdatedAt "2026-03-19T14:04:55Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasSegway rdf:type owl:ObjectProperty .
foundation:hasSegway rdfs:comment "Conecta um EndEvent interno de um SubProcess ao próximo node no processo pai. Substitui o SequenceFlow de saída do SubProcess."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasSegway rdfs:domain foundation:automation_SubProcess .
foundation:hasSegway rdfs:label "Tem Segway"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasSegway rdfs:range foundation:automation_SubProcessSegway .
foundation:hasSequenceFlow foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:hasSequenceFlow foundation:lastUpdatedAt "2026-04-10T03:25:05.731896+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasSequenceFlow rdf:type owl:ObjectProperty .
foundation:hasSequenceFlow rdfs:comment "SequenceFlows that define the execution order within this process"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasSequenceFlow rdfs:domain foundation:Automation .
foundation:hasSequenceFlow rdfs:domain foundation:automation_SubProcess .
foundation:hasSequenceFlow rdfs:label "Tem Fluxo de Sequência"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasSequenceFlow rdfs:range foundation:automation_SequenceFlow .
foundation:hasSkill rdf:type owl:ObjectProperty .
foundation:hasSkill rdfs:comment "Competências/skills de uma pessoa ou experiência"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasSkill rdfs:domain foundation:Person .
foundation:hasSkill rdfs:domain foundation:ProfessionalExperience .
foundation:hasSkill rdfs:label "Tem Competência"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasSkill rdfs:range foundation:ProfessionalSkill .
foundation:hasStartTime rdf:type owl:DatatypeProperty .
foundation:hasStartTime rdfs:comment "Momento em que o evento/processo começa. Herdado por todos os Occurrents (FinancialTransaction, Conversation, AIAPICall, Approval, etc.). Substitui propriedades específicas de cada classe (transactionDate, startedAt, etc.) — daqui pra frente, prefira usar hasStartTime."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStartTime rdfs:domain foundation:MorningBriefingRun .
foundation:hasStartTime rdfs:domain foundation:Occurrent .
foundation:hasStartTime rdfs:label "Início"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStartTime rdfs:range xsd:dateTime .
foundation:hasState foundation:lastUpdatedAt "2026-04-10T03:25:05.891174+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasState rdf:type owl:ObjectProperty .
foundation:hasState rdfs:comment "Links address to a state/province entity (preferred over administrativeAreaLevel1 string)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasState rdfs:domain foundation:Address .
foundation:hasState rdfs:label "Tem Estado"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasState rdfs:range foundation:State .
foundation:hasState rdfs:seeAlso "\nThis property should be used instead of foundation:administrativeAreaLevel1\nfor new implementations. It provides a reference to a structured State entity.\n\nExample:\n  :myAddress foundation:hasState :state_sao_paulo .\n\n  :state_sao_paulo a foundation:State ;\n      foundation:stateName \"São Paulo\" ;\n      foundation:stateCode \"SP\" ;\n      foundation:isPartOf :country_brazil .\n\nBenefits over string property:\n- Enables state-level hierarchy navigation\n- Supports state codes and metadata\n- Facilitates regional queries and analysis\n- Links to country entities\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStatus foundation:aiBehaviorRules "**Status is mandatory** — every entity created or modified has its status updated in the same operation. Adding AC to a Completed story = move to Pending Change. Creating a story = set status. No exceptions."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStatus foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:hasStatus foundation:lastUpdatedAt "2026-04-10T03:25:06.096803+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasStatus rdf:type owl:ObjectProperty .
foundation:hasStatus rdfs:comment "The current state of work"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStatus rdfs:domain foundation:Continuant .
foundation:hasStatus rdfs:domain foundation:Occurrent .
foundation:hasStatus rdfs:domain foundation:Organization .
foundation:hasStatus rdfs:domain foundation:Quality .
foundation:hasStatus rdfs:label "has status"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStatus rdfs:range foundation:Status .
foundation:hasStepExecutions foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:hasStepExecutions foundation:lastUpdatedAt "2026-04-10T03:25:06.294692+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasStepExecutions rdf:type owl:ObjectProperty .
foundation:hasStepExecutions rdfs:comment "Step executions within this workflow"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStepExecutions rdfs:domain foundation:WorkflowExecution .
foundation:hasStepExecutions rdfs:label "Tem Execuções de Etapa"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasStepExecutions rdfs:range foundation:StepExecution .
foundation:hasStorage foundation:lastUpdatedAt "2026-04-10T03:25:13.796550+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasStorage rdf:type owl:ObjectProperty .
foundation:hasStorage rdfs:comment "Storage devices that are part of or connected to this computer"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStorage rdfs:domain foundation:Computer .
foundation:hasStorage rdfs:label "Tem Armazenamento"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasStorage rdfs:range foundation:StorageDevice .
foundation:hasStorage rdfs:seeAlso "\nExample:\n  :macbook foundation:hasStorage :ssd1 .\n  :server foundation:hasStorage :disk-array .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStreet foundation:lastUpdatedAt "2026-04-10T03:25:13.950596+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasStreet rdf:type owl:ObjectProperty .
foundation:hasStreet rdfs:comment "Links address to a street entity (preferred over route string)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasStreet rdfs:domain foundation:Address .
foundation:hasStreet rdfs:label "Tem Rua"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:hasStreet rdfs:range foundation:Street .
foundation:hasStreet rdfs:seeAlso "\nThis property should be used instead of foundation:route for new implementations.\nIt provides a reference to a structured Street entity rather than a string literal.\n\nExample:\n  :myAddress foundation:hasStreet :street_avenida_paulista .\n\n  :street_avenida_paulista a foundation:Street ;\n      foundation:streetName \"Avenida Paulista\" .\n\nBenefits over string property:\n- Enables street-level queries and navigation\n- Supports street hierarchy (part of neighborhood/city)\n- Allows street metadata (type, historical names, etc.)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasToolExecution rdf:type owl:ObjectProperty .
foundation:hasToolExecution rdfs:comment "Links a speak or question assistant message to the intermediate tool_use assistant messages that were executed during the same conversation turn, in order."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasToolExecution rdfs:domain foundation:AIConversationMessage .
foundation:hasToolExecution rdfs:label "Has Tool Execution"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasToolExecution rdfs:range foundation:AIConversationMessage .
foundation:hasToolResultMessage rdf:type owl:ObjectProperty .
foundation:hasToolResultMessage rdfs:comment "Links an assistant AIConversationMessage containing tool_use blocks to the user AIConversationMessage containing the corresponding tool_result blocks."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasToolResultMessage rdfs:domain foundation:AIConversationMessage .
foundation:hasToolResultMessage rdfs:label "Tool Result Message"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasToolResultMessage rdfs:range foundation:AIConversationMessage .
foundation:hasUser foundation:isSystemLocked "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:hasUser foundation:lastUpdatedAt "2026-04-10T03:25:14.118441+00:00"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasUser rdf:type owl:ObjectProperty .
foundation:hasUser rdfs:comment "Person who uses this computer"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasUser rdfs:domain foundation:Computer .
foundation:hasUser rdfs:label "Tem Usuário"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasUser rdfs:range foundation:Person .
foundation:hasUser rdfs:seeAlso "\nExample:\n  :macbook foundation:hasUser :daniel .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasValidationEvidence rdf:type owl:ObjectProperty .
foundation:hasValidationEvidence rdfs:comment "Relaciona um critério às tentativas imutáveis de validação registradas para ele."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasValidationEvidence rdfs:domain foundation:AcceptanceCriterion .
foundation:hasValidationEvidence rdfs:label "Tem Evidência de Validação"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasValidationEvidence rdfs:range foundation:AcceptanceCriterionValidation .
foundation:hasWebPresence rdf:type owl:DatatypeProperty .
foundation:hasWebPresence rdfs:comment "URLs de presença online (website, LinkedIn, GitHub, portfolio, etc.)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasWebPresence rdfs:domain foundation:Company .
foundation:hasWebPresence rdfs:domain foundation:Person .
foundation:hasWebPresence rdfs:label "Tem Presença Online"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasWebPresence rdfs:range xsd:anyURI .
foundation:hasWorkLocationAddress foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:hasWorkLocationAddress rdf:type owl:ObjectProperty .
foundation:hasWorkLocationAddress rdfs:comment "Links a service contract to a specific physical address where work is performed (use alongside workLocation string for classifications)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasWorkLocationAddress rdfs:domain foundation:ServiceContract .
foundation:hasWorkLocationAddress rdfs:label "endereço de trabalho"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:hasWorkLocationAddress rdfs:range foundation:Address .
foundation:hasWorkLocationAddress rdfs:seeAlso "\nThis property provides a structured reference to a physical address where services\nwill be performed. It should be used in combination with foundation:workLocation\nstring property for work arrangement classifications.\n\nUsage patterns:\n- For remote work: Only use foundation:workLocation \"Remote\"\n- For on-site work: Use both properties:\n  * foundation:workLocation \"On-site\"\n  * foundation:hasWorkLocationAddress :clientOfficeAddress\n\n- For hybrid work: Use both properties:\n  * foundation:workLocation \"Hybrid (2 days on-site, 3 days remote)\"\n  * foundation:hasWorkLocationAddress :clientOfficeAddress\n\nExample 1 - Pure remote (no address needed):\n  :remoteDevContract a foundation:ServiceContract ;\n      foundation:workLocation \"Remote\" .\n\nExample 2 - On-site with address:\n  :consultingContract a foundation:ServiceContract ;\n      foundation:workLocation \"On-site\" ;\n      foundation:hasWorkLocationAddress :clientSFOffice .\n\n  :clientSFOffice a foundation:Address ;\n      foundation:streetNumber \"123\" ;\n      foundation:hasStreet :street_market ;\n      foundation:hasCity :city_san_francisco ;\n      foundation:hasState :state_california ;\n      foundation:hasCountry :country_usa .\n\nExample 3 - Hybrid with address:\n  :maintenanceContract a foundation:ServiceContract ;\n      foundation:workLocation \"Hybrid (2 days on-site, 3 days remote)\" ;\n      foundation:hasWorkLocationAddress :companyHeadquarters .\n\nBenefits:\n- Enables location-based contract queries\n- Supports travel and expense tracking\n- Facilitates compliance with local regulations\n- Links to structured geographic data\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:height foundation:isSystemLocked "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
foundation:height foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:height qudt:hasUnit unit:M .
