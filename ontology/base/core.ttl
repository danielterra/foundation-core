foundation:Invoice foundation:allowedStatus foundation:Completed .
foundation:Invoice foundation:allowedStatus foundation:Pending .
foundation:Invoice foundation:hasIcon foundation:icon-material-symbols-name-receipt_long .
foundation:Invoice foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Invoice owl:imports <http://qudt.org/2.1/vocab/currency> .
foundation:Invoice rdf:type owl:Class .
foundation:Invoice rdfs:comment "A bill or request for payment for goods or services provided"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Invoice rdfs:comment "Bills and requests for payment"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Invoice rdfs:label "Nota Fiscal"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Invoice rdfs:seeAlso "\nAn invoice is a document requesting payment.\n\nKey information:\n- Invoice number\n- Issue date and due date\n- Seller (who issued the invoice)\n- Buyer (who should pay)\n- Line items with descriptions and amounts\n- Total amount due\n- Payment terms\n\nExample:\n  :invoice123 a foundation:Invoice ;\n      foundation:invoiceNumber \"INV-2024-0123\" ;\n      foundation:issueDate \"2024-01-15\"^^xsd:date ;\n      foundation:dueDate \"2024-02-14\"^^xsd:date ;\n      foundation:invoicedBy :consultingFirm ;\n      foundation:invoicedTo :clientCompany ;\n      foundation:invoiceAmount \"5000.00\"^^xsd:decimal ;\n      foundation:invoiceCurrency currency:USD ;\n      foundation:invoiceStatus \"Paid\" ;\n      foundation:relatedContract :serviceContract2024 .\n\nCardinality constraints:\n- invoiceNumber: exactly 1 (required)\n- issueDate: exactly 1 (required)\n- dueDate: exactly 1 (required)\n- invoiceAmount: exactly 1 (required)\n- invoiceCurrency: exactly 1 (required)\n- invoicedBy: exactly 1 (required)\n- invoicedTo: exactly 1 (required)\n- invoiceStatus: max 1 (optional)\n- relatedContract: max 1 (optional)\n- taxAmount: max 1 (optional)\n- subtotalAmount: max 1 (optional)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Invoice rdfs:subClassOf foundation:AbstractContinuant .
