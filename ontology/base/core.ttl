foundation:AIModel foundation:lastUpdatedAt "2026-03-04T04:10:27Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:AIModel rdf:type owl:Class .
foundation:AIModel rdfs:comment "A specific version or variant of an AI language model (e.g., Claude 3.5 Sonnet, GPT-4)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIModel rdfs:label "Modelo de IA"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIModel rdfs:seeAlso "\nExamples:\n- Claude 3.5 Sonnet (claude-3-5-sonnet-20240620)\n- Claude 3 Opus (claude-3-opus-20240229)\n- GPT-4 Turbo\n- Gemini 1.5 Pro\n\nCardinality constraints:\n- modelIdentifier: exactly 1 (required, unique ID for API calls)\n- offeredBy: exactly 1 (required, which service provides this model)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:AIModel rdfs:subClassOf foundation:AbstractContinuant .
