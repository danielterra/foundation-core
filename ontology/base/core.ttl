unit:MilliDARCY foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
unit:MilliDARCY <http://purl.org/dc/terms/description> "\n  The $\\textit{Millidarcy}$ ($md$) is a unit of permeability named after Henry Darcy. \n  It is not an SI unit, but it is widely used in petroleum engineering and geology. \n  The unit has also been used in biophysics and biomechanics, where the flow of fluids such as \n  blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined. \n  A millidarcy has dimensional units of $length^2$.\n  "^^<http://qudt.org/schema/qudt/LatexString> .
unit:MilliDARCY qudt:applicableSystem <http://qudt.org/vocab/sou/CGS> .
unit:MilliDARCY qudt:applicableSystem <http://qudt.org/vocab/sou/SI> .
unit:MilliDARCY qudt:conversionMultiplier "0.0000000000000009869233"^^<http://www.w3.org/2001/XMLSchema#decimal> .
unit:MilliDARCY qudt:conversionMultiplierSN "0.0000000000000009869233"^^<http://www.w3.org/2001/XMLSchema#decimal> .
unit:MilliDARCY qudt:expression "$d$"^^<http://qudt.org/schema/qudt/LatexString> .
unit:MilliDARCY qudt:hasDimensionVector <http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0> .
unit:MilliDARCY qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/HydraulicPermeability> .
unit:MilliDARCY qudt:informativeReference "https://en.wikipedia.org/wiki/Darcy_(unit)"^^<http://www.w3.org/2001/XMLSchema#anyURI> .
unit:MilliDARCY qudt:plainTextDescription "The millidarcy (md) is a unit of permeability named after Henry Darcy. It is not an SI unit, but it is widely used in petroleum engineering and geology. The unit has also been used in biophysics and biomechanics, where the flow of fluids such as blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined. A millidarcy has dimensional units of length²."^^<http://www.w3.org/2001/XMLSchema#string> .
unit:MilliDARCY qudt:symbol "md"^^<http://www.w3.org/2001/XMLSchema#string> .
