qudt:Comment rdf:type owl:Class .
qudt:Comment rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:Comment rdfs:label "Comment"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:Comment rdfs:subClassOf owl:Thing .
qudt:Comment rdfs:subClassOf qudt:Verifiable .
qudt:Concept foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:Concept rdf:type owl:Class .
qudt:Concept rdfs:comment "The root class for all QUDT concepts."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:Concept rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:Concept rdfs:label "QUDT Concept"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:Concept rdfs:subClassOf owl:Thing .
qudt:ConstantValue foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:ConstantValue rdf:type owl:Class .
qudt:ConstantValue rdfs:comment "Used to specify the values of a constant."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:ConstantValue rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:ConstantValue rdfs:label "Constant value"^^<http://www.w3.org/2001/XMLSchema#string> .
