foundation:Rejected rdfs:label "Rejeitado"^^<http://www.w3.org/2000/01/rdf-schema#Literal> .
foundation:RentalContract foundation:hasIcon foundation:icon-material-symbols-name-home .
foundation:RentalContract foundation:lastUpdatedAt "2026-03-07T00:30:03Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:RentalContract rdf:type owl:Class .
foundation:RentalContract rdfs:comment "A legally binding agreement for the rental of residential or commercial property, specifying rent amount, payment terms, duration, and tenant/landlord obligations"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RentalContract rdfs:label "Contrato de Aluguel"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RentalContract rdfs:subClassOf foundation:ServiceContract .
foundation:Requirement rdf:type owl:Class .
foundation:Role foundation:hasIcon foundation:icon-material-symbols-name-badge .
foundation:Role rdf:type owl:Class .
foundation:Role rdfs:comment "Concrete instantiation of a responsibility or role. Distinct from Person/Org. Represents a named job function that can be assigned to agents."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Role rdfs:label "Função"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Role rdfs:subClassOf foundation:AbstractQuality .
foundation:RomanticRelationship foundation:hasIcon foundation:icon-material-symbols-name-favorite .
foundation:RomanticRelationship foundation:lastUpdatedAt "2026-03-06T00:03:01Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:RomanticRelationship rdf:type owl:Class .
foundation:RomanticRelationship rdfs:comment "A romantic partnership between two people, with temporal information (start date, end date, status)"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RomanticRelationship rdfs:label "Relacionamento Romântico"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:RomanticRelationship rdfs:subClassOf foundation:Event .
foundation:Runtime foundation:hasIcon foundation:icon-material-symbols-name-memory .
foundation:Runtime foundation:lastUpdatedAt "2026-03-04T16:45:44Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Runtime rdf:type owl:Class .
foundation:Runtime rdfs:comment "An execution environment that applications depend on to run — such as a language runtime (Python, JVM, Node.js), a browser engine, or a container runtime. Runs on top of an Operating System."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Runtime rdfs:label "Runtime"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Runtime rdfs:subClassOf foundation:Software .
foundation:SaaSProduct foundation:hasIcon foundation:icon-material-symbols-name-cloud .
foundation:SaaSProduct foundation:lastUpdatedAt "2026-03-02T20:41:10Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:SaaSProduct rdf:type owl:Class .
foundation:SaaSProduct rdfs:comment "A Software as a Service product — cloud-based software delivered over the internet on a subscription or usage basis"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:SaaSProduct rdfs:label "Produto SaaS"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:SaaSProduct rdfs:subClassOf foundation:SoftwareProduct .
foundation:SalaryHistory foundation:hasIcon foundation:icon-material-symbols-name-payments .
foundation:SalaryHistory foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:SalaryHistory rdf:type owl:Class .
foundation:SalaryHistory rdfs:comment "A salary change record within an employment contract, with date and value"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:SalaryHistory rdfs:label "Histórico Salarial"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:SalaryHistory rdfs:seeAlso "\nTracks salary changes over the course of an employment contract.\n\nCardinality constraints:\n- effectiveDate: exactly 1 (required - must have an effective date)\n- salaryAmount: exactly 1 (required - must have a salary amount)\n- changeReason: 0-1 (one reason per salary change)\n\nExample:\n  :johnSalaryChange1 a foundation:SalaryHistory ;\n      foundation:hasSalaryHistory :johnEmployment ;\n      foundation:effectiveDate \"2021-01-15\"^^xsd:date ;\n      foundation:salaryAmount \"6000.00\"^^xsd:decimal ;\n      foundation:changeReason \"Annual adjustment\" .\n\n  :johnSalaryChange2 a foundation:SalaryHistory ;\n      foundation:hasSalaryHistory :johnEmployment ;\n      foundation:effectiveDate \"2022-06-01\"^^xsd:date ;\n      foundation:salaryAmount \"7500.00\"^^xsd:decimal ;\n      foundation:changeReason \"Promotion to Senior Engineer\" .\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:SalaryHistory rdfs:subClassOf foundation:AbstractContinuant .
foundation:Screen foundation:allowedStatus foundation:Completed .
foundation:Screen foundation:allowedStatus foundation:InProgress .
foundation:Screen foundation:allowedStatus foundation:Pending .
foundation:Screen foundation:allowedStatus foundation:Rejected .
foundation:Screen foundation:hasIcon foundation:icon-material-symbols-name-phone_iphone .
foundation:Screen foundation:lastUpdatedAt "2026-03-18T14:33:43Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Screen rdf:type owl:Class .
foundation:Screen rdfs:comment "A screen or interface of a software product. Represents what the user sees and interacts with — at the right level of abstraction between a UI component (too technical) and a feature (too broad). A screen can satisfy multiple user stories and relate to multiple features."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Screen rdfs:label "Tela"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Screen rdfs:subClassOf foundation:AbstractContinuant .
foundation:ScreenCapture foundation:allowedStatus foundation:Completed .
foundation:ScreenCapture foundation:allowedStatus foundation:InProgress .
foundation:ScreenCapture foundation:allowedStatus foundation:Pending .
foundation:ScreenCapture foundation:allowedStatus foundation:Rejected .
foundation:ScreenCapture foundation:cascadeDeleteRange foundation:attachesFile .
foundation:ScreenCapture foundation:hasIcon foundation:icon-material-symbols-name-screenshot_monitor .
foundation:ScreenCapture rdf:type owl:Class .
foundation:ScreenCapture rdfs:comment "Captured media from the user's screen — either a screenshot (PNG/JPEG) or a screen recording (WebM). Stores the original capture, the AI-generated description, and metadata about the capture context (focus instruction, quality, duration, model used). Created by the capture_screenshot and capture_screen_recording TauriCommands + MCPTools."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ScreenCapture rdfs:label "Captura de Tela"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ScreenCapture rdfs:subClassOf foundation:MediaAnalysis .
foundation:SemanticComponentDefinition foundation:hasIcon foundation:icon-material-symbols-name-widgets .
foundation:SemanticComponentDefinition rdf:type owl:Class .
foundation:SemanticComponentDefinition rdfs:comment "Ontology-readable contract for one semantic json-render component, generated from the runtime renderer catalog. Stores component identity, intent, JSON schemas, examples, and catalog version for on-demand agent discovery."^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:SemanticComponentDefinition rdfs:label "Definição de Componente Semântico"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:SemanticComponentDefinition rdfs:subClassOf foundation:AbstractContinuant .
foundation:Service foundation:hasIcon foundation:icon-material-symbols-name-handyman .
foundation:Service foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:Service rdf:type owl:Class .
foundation:Service rdfs:comment "An intangible offering that provides value through actions, labor, expertise, or access rather than transfer of physical goods"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Service rdfs:label "Serviço"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Service rdfs:seeAlso "\nExamples:\n- Residential cleaning service\n- Computer repair service\n- Business consulting service\n- Software development service\n- AWS S3 (cloud storage service - SaaS)\n- Netflix (streaming service)\n- Uber (transportation service)\n- Food delivery service\n\nServices can be:\n- Physical services (cleaning, repair, transportation)\n- Professional services (consulting, legal, accounting)\n- Digital services (SaaS, streaming, cloud computing)\n\nCardinality constraints:\n- providedBy: at least 1 (required, service must have provider(s))\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:Service rdfs:subClassOf foundation:AbstractProduct .
foundation:ServiceContract foundation:hasIcon foundation:icon-material-symbols-name-handshake .
foundation:ServiceContract foundation:lastUpdatedAt "2026-03-04T04:10:28Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
foundation:ServiceContract owl:imports foundation:Address .
foundation:ServiceContract owl:imports foundation:Contract .
foundation:ServiceContract rdf:type owl:Class .
foundation:ServiceContract rdfs:comment "A contract that specifies the provision of services by a contractor to a client"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ServiceContract rdfs:comment "Service contract and milestone concepts"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ServiceContract rdfs:label "Contrato de Serviço"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ServiceContract rdfs:seeAlso "\nA service contract defines the terms under which services are provided.\n\nExamples:\n- Software development contract\n- Consulting services agreement\n- Maintenance and support contract\n- Cleaning services contract\n- IT support contract\n- Professional services agreement\n\nKey characteristics:\n- Defines scope of services\n- May include deliverables and milestones\n- Often includes payment terms and schedule\n- May specify service level agreements (SLAs)\n"^^<http://www.w3.org/2001/XMLSchema#string> .
foundation:ServiceContract rdfs:subClassOf foundation:Contract .
