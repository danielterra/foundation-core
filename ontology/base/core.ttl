qudt:hasAllowedUnit foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:hasAllowedUnit <http://purl.org/dc/terms/description> "This property relates a unit system with a unit of measure that is not defined by or part of the system, but is allowed for use within the system. An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:hasAllowedUnit rdf:type owl:ObjectProperty .
qudt:hasAllowedUnit rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:hasAllowedUnit rdfs:label "allowed unit"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:hasAllowedUnit rdfs:subPropertyOf qudt:hasUnit .
qudt:hasBaseQuantityKind foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:hasBaseQuantityKind rdf:type owl:FunctionalProperty .
qudt:hasBaseQuantityKind rdf:type owl:ObjectProperty .
qudt:hasBaseQuantityKind rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:hasBaseQuantityKind rdfs:label "has base quantity kind"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:hasBaseQuantityKind rdfs:subPropertyOf qudt:hasQuantityKind .
qudt:hasBaseUnit foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:hasBaseUnit <http://purl.org/dc/terms/description> "This property relates a system of units to a base unit defined within the system. The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:hasBaseUnit owl:inverseOf qudt:baseUnitOfSystem .
qudt:hasBaseUnit rdf:type owl:ObjectProperty .
qudt:hasBaseUnit rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:hasBaseUnit rdfs:label "base unit"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:hasBaseUnit rdfs:subPropertyOf qudt:hasCoherentUnit .
qudt:hasCitation foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:hasCitation qudt:plainTextDescription "Used to provide an annotation for an informative reference."^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:hasCitation rdf:type owl:DatatypeProperty .
qudt:hasCitation rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:hasCitation rdfs:label "citation"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:hasCitation rdfs:range xsd:string .
qudt:hasCoherentUnit foundation:lastUpdatedAt "2026-03-04T04:10:29Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .
qudt:hasCoherentUnit <http://purl.org/dc/terms/description> "A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers of the system's base units with the proportionality factor of one."^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML> .
qudt:hasCoherentUnit owl:inverseOf qudt:coherentUnitOfSystem .
qudt:hasCoherentUnit rdf:type owl:ObjectProperty .
qudt:hasCoherentUnit rdfs:isDefinedBy <http://qudt.org/2.1/schema/qudt> .
qudt:hasCoherentUnit rdfs:label "coherent unit"^^<http://www.w3.org/2001/XMLSchema#string> .
qudt:hasCoherentUnit rdfs:subPropertyOf qudt:hasDefinedUnit .
