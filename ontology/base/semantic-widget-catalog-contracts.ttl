foundation:SemanticComponentDefinition_Information_v2 foundation:componentActionsSchema "[{\"description\":\"Apresenta uma mensagem local no widget.\",\"id\":\"announce\",\"paramsSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"message\":{\"maxLength\":500,\"type\":\"string\"}},\"required\":[\"message\"],\"type\":\"object\"}},{\"description\":\"Executa uma ação local explicitamente conectada pelo widget.\",\"id\":\"perform\",\"paramsSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{},\"type\":\"object\"}},{\"description\":\"Atualiza estado local do widget.\",\"id\":\"setState\",\"paramsSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"statePath\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"statePath\",\"value\"],\"type\":\"object\"}},{\"description\":\"Adiciona valor ao estado local do widget.\",\"id\":\"pushState\",\"paramsSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"statePath\":{\"type\":\"string\"},\"value\":{}},\"required\":[\"statePath\",\"value\"],\"type\":\"object\"}},{\"description\":\"Remove valor do estado local do widget.\",\"id\":\"removeState\",\"paramsSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"index\":{\"type\":\"number\"},\"statePath\":{\"type\":\"string\"}},\"required\":[\"statePath\",\"index\"],\"type\":\"object\"}},{\"description\":\"Valida formulário local.\",\"id\":\"validateForm\",\"paramsSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"formPath\":{\"type\":\"string\"}},\"required\":[\"formPath\"],\"type\":\"object\"}}]" .
